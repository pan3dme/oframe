  <library_effects>
    <effect id="BuildingMat-00081_002-effect">
      <profile_COMMON>
        <newparam sid="_-00081-texture_png-surface">
          <surface type="2D">
            <init_from>_-00081-texture_png</init_from>
          </surface>
        </newparam>
        <newparam sid="_-00081-texture_png-sampler">
          <sampler2D>
