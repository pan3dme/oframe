/**custom-tab-bar/index.wxss**/
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: content-box;
  display: flex;
  flex-direction: row;
  background: #ffffff;
  border-top: 1rpx solid #eeeeee;
  /* 低于弹窗(999)，高于普通内容 */
  z-index: 100;
}

.tab-bar-item {
  flex: 1;
  height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tab-icon-box {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
}

.tab-text {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.2;
}

/* "设备"tab 无感刷新中的转圈加载态 */
.tab-spinner {
  width: 40rpx;
  height: 40rpx;
  box-sizing: border-box;
  border: 4rpx solid #07c160;
  border-top-color: transparent;
  border-radius: 50%;
  animation: tab-bar-spin 0.8s linear infinite;
}

@keyframes tab-bar-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
