<!--livestock.wxml-->
<navigation-bar title="管理牛羊" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<canvas type="2d" id="compressCanvas" style="width:512px;height:512px;position:fixed;left:-9999px"></canvas>
<scroll-view class="scrollarea" scroll-y type="list" refresher-enabled="{{true}}" refresher-triggered="{{refresherTriggered}}" bindrefresherrefresh="onPullDownRefresh">

<!-- 顶部操作栏 -->
<view class="toolbar">
  <view class="toolbar-count">共 {{livestockList.length}} 头牛羊</view>
  <view class="toolbar-btn" bindtap="onAdd" wx:if="{{isAdmin}}">＋ 新增牛羊</view>
</view>

  <!-- 牛羊列表（单行模式） -->
  <view class="list-panel" wx:if="{{livestockList.length > 0 && singleLineRecord}}">
    <view class="list-item list-item-compact" wx:for="{{livestockList}}" wx:key="name" bindtap="onItemTap" data-name="{{item.name}}">
      <text class="item-index">{{index + 1}}</text>
      <view class="item-icon-compact">🐂</view>
      <view class="item-info">
        <view class="item-line-one">
          <text class="item-name-compact">{{item.name}}</text>
          <text class="item-time-compact">{{item.age}} {{item.gender}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 牛羊列表（完整模式） -->
  <view class="list-panel" wx:elif="{{livestockList.length > 0}}">
    <view class="list-item" wx:for="{{livestockList}}" wx:key="name" bindtap="onItemTap" data-name="{{item.name}}">
      <text class="item-index">{{index + 1}}</text>
      <image class="item-avatar" src="{{item.avatar}}" mode="aspectFill" wx:if="{{item.avatar}}" />
      <view class="item-avatar-placeholder" wx:else>🐂</view>
      <view class="item-info">
        <view class="item-name">{{item.name}}</view>
        <view class="item-meta">
          <text class="item-birthday">{{item.age}}</text>
          <text class="item-gender {{item.gender === '公' ? 'gender-male' : 'gender-female'}}">{{item.gender}}</text>
        </view>
        <view class="item-id" wx:if="{{item.cowsheepId}}">ID: {{item.cowsheepId}}</view>
        <view class="item-device" wx:if="{{item.connectedDevice}}">连接设备: {{item.connectedDevice}}</view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="list-panel" wx:else>
    <view class="empty-tip">暂无牛羊数据</view>
  </view>
</scroll-view>

<!-- 新增牛羊弹窗 -->
<view class="modal" wx:if="{{showAddModal}}">
  <view class="modal-mask" bindtap="onAddClose"></view>
  <view class="modal-dialog">
    <view class="modal-close" bindtap="onAddClose">✕</view>
    <view class="modal-title">新增牛羊</view>

    <!-- 唯一编号 -->
    <view class="modal-label">唯一编号 (cowsheep_id)</view>
    <input class="modal-input" 
      value="{{addCowsheepId}}" 
      placeholder="请输入唯一编号" 
      bindinput="onAddCowsheepIdInput" />

    <!-- 生日 -->
    <view class="modal-label">生日</view>
    <picker mode="date" value="{{addBirthday}}" bindchange="onAddBirthdayChange">
      <view class="modal-picker">{{addBirthday || '请选择生日'}}</view>
    </picker>

    <!-- 性别 -->
    <view class="modal-label">性别</view>
    <picker mode="selector" range="{{genderOptions}}" value="{{addGenderIndex}}" bindchange="onAddGenderChange">
      <view class="modal-picker">{{genderOptions[addGenderIndex]}}</view>
    </picker>

    <!-- 按钮 -->
    <view class="modal-btns">
      <button class="modal-btn modal-btn-gray" bindtap="onAddClose">取消</button>
      <button class="modal-btn modal-btn-confirm" bindtap="onAddConfirm">确认新增</button>
    </view>
  </view>
</view>

