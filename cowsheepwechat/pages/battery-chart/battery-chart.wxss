/* pages/battery-chart/battery-chart.wxss — 电量走势图 */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
  overflow: hidden;
}

.page-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

/* ========== 顶部控制栏 ========== */
.ctrl-panel {
  margin: 24rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
  flex-shrink: 0;
}

.ctrl-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.ctrl-label {
  font-size: 28rpx;
  color: #555;
  font-weight: 600;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.ctrl-picker {
  flex: 1;
  font-size: 28rpx;
  color: #1565c0;
  padding: 10rpx 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 10rpx;
  background: #fafafa;
}

.ctrl-seg {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  flex: 1;
}

.seg-btn {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  border: 1rpx solid #ddd;
  color: #999;
  background: #fff;
}

.seg-btn-on {
  color: #fff;
  background: #1989fa;
  border-color: #1989fa;
}

/* ========== 状态（加载/错误/空） ========== */
.state-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 60rpx 40rpx;
}

.state-icon {
  font-size: 80rpx;
}

.state-text {
  font-size: 28rpx;
  color: #999;
  text-align: center;
}

.retry-btn {
  margin-top: 20rpx;
  padding: 16rpx 48rpx;
  font-size: 28rpx;
  background: #07c160;
  color: #fff;
  border-radius: 40rpx;
  border: none;
}

/* ========== 图表 ========== */
.chart-panel {
  margin: 24rpx 24rpx 0;
  padding: 20rpx 16rpx 12rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
  flex-shrink: 0;
}

.chart-header {
  display: flex;
  align-items: center;
  padding: 0 8rpx 8rpx;
}

.chart-title {
  font-size: 28rpx;
  color: #555;
  font-weight: 600;
}

.chart-count {
  margin-left: auto;
  font-size: 24rpx;
  color: #999;
}

.chart-hover {
  margin: 0 8rpx 8rpx;
  padding: 8rpx 16rpx;
  background: #e8f3ff;
  color: #1565c0;
  font-size: 26rpx;
  border-radius: 8rpx;
  text-align: center;
}

.chart-hover-idle {
  background: #f7f7f7;
  color: #bbb;
  font-size: 22rpx;
}

.chart-canvas {
  width: 100%;
  height: 480rpx;
}

/* ========== 底部说明 ========== */
.tip-panel {
  margin: 24rpx 24rpx;
  padding: 16rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #666;
}

.tip-text-sub {
  color: #aaa;
  font-size: 22rpx;
}

/* ========== 时间偏差独立图表 ========== */
.delta-panel {
  margin-top: 16rpx;
}

.delta-canvas {
  width: 100%;
  height: 220rpx;
  display: block;
}
