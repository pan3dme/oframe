/**cloud-records.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
  overflow: hidden;
}

.page-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

/* ========== 加载 / 错误 ========== */
.loading-box,
.error-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.loading-text {
  font-size: 30rpx;
  color: #999;
}

.error-icon {
  font-size: 80rpx;
}

.error-text {
  font-size: 28rpx;
  color: #999;
}

.retry-btn {
  margin-top: 20rpx;
  padding: 16rpx 48rpx;
  font-size: 28rpx;
  background: #07c160;
  color: #fff;
  border-radius: 40rpx;
  border: none;
}

/* ========== 标题 + 筛选栏（参照设备详情"数据记录"标题栏） ========== */
.recv-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 24rpx 24rpx 0;
  padding: 16rpx 20rpx;
  background: #fff;
  font-size: 28rpx;
  color: #555;
  font-weight: 600;
  border-bottom: 1rpx solid #f0f0f0;
  border-radius: 16rpx 16rpx 0 0;
  flex-shrink: 0;
}

.recv-label {
  font-size: 28rpx;
  color: #555;
  font-weight: 600;
  flex-shrink: 0;
}

.recv-filters {
  display: flex;
  gap: 10rpx;
  flex-shrink: 0;
  flex-wrap: wrap;
}

.recv-filter-btn {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  border: 1rpx solid #ddd;
  color: #999;
  background: #fff;
  white-space: nowrap;
}

.recv-filter-on {
  color: #fff;
  background: #1989fa;
  border-color: #1989fa;
}

.recv-count {
  margin-left: auto;
  font-size: 24rpx;
  color: #999;
  flex-shrink: 0;
  font-weight: normal;
}

.recv-scroll {
  flex: 1;
  min-height: 0;
}

/* ========== 数据记录列表（完全参照设备详情页排版） ========== */
.msg-panel {
  margin: 0 24rpx 24rpx;
  border-radius: 0 0 16rpx 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.record-item {
  padding: 20rpx 24rpx;
  font-size: 32rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
  line-height: 1.6;
}

.record-item:last-child {
  border-bottom: none;
}

.rec-row {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
}

.rec-row-time {
  padding-bottom: 0;
}

.rec-row-content {
}

.rec-val {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  word-break: break-all;
}

.rec-val-time {
  color: #555;
  font-weight: 500;
}

.rec-val-update {
  color: #888;
  font-size: 30rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.rec-val-alias {
  font-size: 24rpx;
  font-weight: normal;
  color: #000;
}

.rec-val-lora {
  color: #1565c0;
  font-size: 32rpx;
}

/* 定位记录点击箭头 */
.rec-tap-arrow {
  font-size: 40rpx;
  color: #1976d2;
  font-weight: 700;
  flex-shrink: 0;
  margin-left: 12rpx;
  line-height: 1;
}

/* RSSI / SNR 行 */
.rec-row-rssi {
  padding-top: 4rpx;
  justify-content: space-between;
}

.rec-val-rssi {
  font-size: 24rpx;
  flex-shrink: 0;
}

.rec-val-snr {
  font-size: 24rpx;
  flex-shrink: 0;
}

/* 类型徽章 */
.rec-icon-lora {
  display: inline-block;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  color: #fff;
  background: #999;
  margin-right: 10rpx;
  flex-shrink: 0;
  line-height: 1.6;
}

.rec-icon-lora.type-1 {
  background: #1976d2;
}

.rec-icon-lora.type-2 {
  background: #ff9500;
}

.rec-icon-lora.type-3 {
  background: #4CAF50;
}

.rec-icon-lora.type-5 {
  background: #8E24AA;
}

.rec-icon-lora.type-6 {
  background: #607D8B;
}

/* 空状态 */
.empty-tip {
  text-align: center;
  font-size: 28rpx;
  color: #bbb;
  padding: 100rpx 0;
  background: #fff;
}

/* 加载更多提示 */
.load-more-tip {
  text-align: center;
  font-size: 26rpx;
  color: #999;
  padding: 24rpx 0;
  background: #fff;
}
