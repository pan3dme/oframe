/**dtu-device.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.section-placeholder {
  height: 40rpx;
}

/* ===== 设备信息卡片 ===== */
.info-card {
  margin: 16rpx 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.info-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 8rpx;
  border-left: 6rpx solid #1989fa;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #999;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  max-width: 55%;
  text-align: right;
  word-break: break-all;
}

/* ===== 连接状态卡片 ===== */
.conn-card {
  margin: 0 24rpx 16rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.conn-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.conn-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.conn-status {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.conn-status.connected {
  background: #e8f5e9;
  color: #4CAF50;
}

.conn-status.connecting {
  background: #fff3e0;
  color: #ff9800;
}

.conn-status.disconnected {
  background: #f5f5f5;
  color: #999;
}

.conn-status.error {
  background: #ffebee;
  color: #f44336;
}

.conn-status.polling {
  background: #e3f2fd;
  color: #1976d2;
}

.conn-status.idle {
  background: #f5f5f5;
  color: #999;
}

.conn-stats {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 16rpx;
  padding: 10rpx 16rpx;
  background: #fafafa;
  border-radius: 8rpx;
}

.conn-error {
  font-size: 24rpx;
  color: #f44336;
  margin-bottom: 16rpx;
  padding: 12rpx 16rpx;
  background: #fff5f5;
  border-radius: 8rpx;
  border-left: 4rpx solid #f44336;
}

.conn-actions {
  display: flex;
  gap: 16rpx;
}

.conn-actions button {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  border-radius: 12rpx;
  padding: 0;
  margin: 0;
}

.btn-connect {
  background: #07c160;
  color: #fff;
}

.btn-reconnect {
  background: #1989fa;
  color: #fff;
}

.btn-disconnect {
  background: #fff;
  color: #f44336;
  border: 2rpx solid #f44336;
}

.btn-send-cmd {
  flex: 1;
  background: #ff9500;
  color: #fff;
}

/* ===== 运行状态 ===== */
.props-card {
  margin: 0 24rpx 16rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.props-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-left: 8rpx;
  border-left: 6rpx solid #07c160;
}

.props-subtitle {
  font-size: 22rpx;
  color: #07c160;
  font-weight: normal;
  margin-left: 8rpx;
}

.prop-item {
  padding: 18rpx 12rpx;
  border-bottom: 1rpx solid #f5f5f5;
  position: relative;
}

.prop-item:last-child {
  border-bottom: none;
}

.prop-name {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.prop-value {
  font-size: 36rpx;
  color: #333;
  font-weight: 600;
  font-family: 'Courier New', monospace;
  word-break: break-all;
}

.prop-value.highlight {
  color: #1989fa;
}

.prop-value.warn {
  color: #ff9800;
}

.prop-time {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 6rpx;
}

/* ===== LoRa 数据网格 ===== */
.lora-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
  gap: 12rpx;
}

.lora-cell {
  background: #f0f8ff;
  border-radius: 10rpx;
  padding: 12rpx 20rpx;
  min-width: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.lora-cell-label {
  font-size: 20rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.lora-cell-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  font-family: 'Courier New', monospace;
}

/* ===== AMQP 架构说明 ===== */
.amqp-info {
  border-left: 4rpx solid #7c4dff;
}

.amqp-flow {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 0;
}

.amqp-step {
  display: flex;
  align-items: center;
  width: 100%;
  padding: 12rpx 16rpx;
  background: #f8f6ff;
  border-radius: 10rpx;
}

.amqp-step-num {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  background: #7c4dff;
  color: #fff;
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: bold;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.amqp-step-text {
  font-size: 24rpx;
  color: #555;
  line-height: 1.5;
}

.amqp-arrow {
  font-size: 28rpx;
  color: #ccc;
  line-height: 1;
}

/* ===== 消息日志 ===== */
.log-card {
  margin: 0 24rpx 16rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  max-height: 500rpx;
}

.log-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
  border-left: 6rpx solid #ff9500;
}

.log-list {
  max-height: 440rpx;
  overflow-y: auto;
}

.log-item {
  display: flex;
  align-items: flex-start;
  padding: 6rpx 0;
  border-bottom: 1rpx solid #fafafa;
}

.log-time {
  font-size: 20rpx;
  color: #aaa;
  font-family: 'Courier New', monospace;
  white-space: nowrap;
  margin-right: 8rpx;
  min-width: 100rpx;
}

.log-type {
  font-size: 20rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.log-type-info {
  background: #e3f2fd;
  color: #1976d2;
}

.log-type-success {
  background: #e8f5e9;
  color: #388e3c;
}

.log-type-error {
  background: #ffebee;
  color: #d32f2f;
}

.log-type-msg {
  background: #fff3e0;
  color: #e65100;
}

.log-text {
  font-size: 22rpx;
  color: #555;
  word-break: break-all;
  line-height: 1.5;
}
