<!--dtu-device.wxml (AMQP模式)-->
<navigation-bar title="DTU设备" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">

  <!-- 设备信息卡片 -->
  <view class="info-card">
    <view class="info-title">📡 设备信息</view>
    <view class="info-row">
      <text class="info-label">设备名称</text>
      <text class="info-value">{{deviceName}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">ProductKey</text>
      <text class="info-value">{{productKey}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">模式</text>
      <text class="info-value">AMQP 订阅(轮询)</text>
    </view>
    <view class="info-row">
      <text class="info-label">产品</text>
      <text class="info-value">牛羊中继</text>
    </view>
  </view>

  <!-- 轮询状态卡片 -->
  <view class="conn-card">
    <view class="conn-header">
      <view class="conn-title">🔄 数据轮询</view>
      <view class="conn-status {{pollStatus}}">{{pollStatusText}}</view>
    </view>
    <view class="conn-error" wx:if="{{pollErrorMsg}}">⚠️ {{pollErrorMsg}}</view>
    <view class="conn-stats" wx:if="{{totalPolls > 0}}">
      <text>已轮询 {{totalPolls}} 次</text>
      <text wx:if="{{lastPollTime}}"> · 最近: {{lastPollTime}}</text>
    </view>
    <view class="conn-actions">
      <button class="btn-connect" bindtap="onRefresh">开始/刷新轮询</button>
      <button class="btn-disconnect" bindtap="onStopPolling" wx:if="{{pollStatus === 'polling'}}">停止轮询</button>
    </view>
    <view class="conn-actions" style="margin-top:16rpx">
      <button class="btn-send-cmd" bindtap="onSendCmd">⚡ 发送指令 (com)</button>
    </view>
  </view>

  <!-- 运行状态：物模型属性 -->
  <view class="props-card">
    <view class="props-title">📊 运行状态 <text class="props-subtitle">自动刷新</text></view>

    <!-- lora信息 -->
    <view class="prop-item">
      <view class="prop-name">lora信息</view>
      <view class="prop-value">{{loraInfo || '--'}}</view>
      <view class="prop-time" wx:if="{{loraInfoTime}}">{{loraInfoTime}}</view>
      <!-- LoRa 数据段解析 -->
      <view class="lora-grid" wx:if="{{loraParsed.length > 0}}">
        <view class="lora-cell" wx:for="{{loraParsed}}" wx:key="label" wx:for-item="field">
          <text class="lora-cell-label">{{field.label}}</text>
          <text class="lora-cell-value">{{field.value}}</text>
        </view>
      </view>
    </view>

    <!-- rssi -->
    <view class="prop-item">
      <view class="prop-name">rssi</view>
      <view class="prop-value highlight {{rssi < -100 ? 'warn' : ''}}">{{rssi || '--'}}</view>
      <view class="prop-time" wx:if="{{rssiTime}}">{{rssiTime}}</view>
    </view>

    <!-- snr -->
    <view class="prop-item">
      <view class="prop-name">snr</view>
      <view class="prop-value">{{snr || '--'}}</view>
      <view class="prop-time" wx:if="{{snrTime}}">{{snrTime}}</view>
    </view>

    <!-- upDateDevice -->
    <view class="prop-item">
      <view class="prop-name">upDateDevice</view>
      <view class="prop-value">{{upDateDevice || '--'}}</view>
      <view class="prop-time" wx:if="{{upDateDeviceTime}}">{{upDateDeviceTime}}</view>
    </view>
  </view>

  <!-- AMQP 架构说明 -->
  <view class="info-card amqp-info">
    <view class="info-title">📨 AMQP 订阅架构</view>
    <view class="amqp-flow">
      <view class="amqp-step">
        <text class="amqp-step-num">1</text>
        <text class="amqp-step-text">DTU设备 → 阿里云IoT MQTT</text>
      </view>
      <view class="amqp-arrow">↓</view>
      <view class="amqp-step">
        <text class="amqp-step-num">2</text>
        <text class="amqp-step-text">云函数(AMQP订阅) → 数据库</text>
      </view>
      <view class="amqp-arrow">↓</view>
      <view class="amqp-step">
        <text class="amqp-step-num">3</text>
        <text class="amqp-step-text">小程序 HTTP 轮询 ← 数据库</text>
      </view>
    </view>
  </view>

  <!-- 消息日志 -->
  <view class="log-card" wx:if="{{msgLog.length > 0}}">
    <view class="log-title">📋 消息日志</view>
    <view class="log-list">
      <view class="log-item" wx:for="{{msgLog}}" wx:key="index">
        <text class="log-time">[{{item.time}}]</text>
        <text class="log-type log-type-{{item.type}}">{{item.type === 'success' ? '✓' : item.type === 'error' ? '✗' : item.type === 'info' ? 'i' : '→'}}</text>
        <text class="log-text">{{item.text}}</text>
      </view>
    </view>
  </view>

  <view class="section-placeholder"></view>
</scroll-view>
