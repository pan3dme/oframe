<!--bluetooth.wxml-->
<navigation-bar title="蓝牙 {{bluetoothConnected ? '📡 ' + connectedDeviceName : '连接'}}" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<view class="page-body">
  <!-- 上部固定区 -->
  <view class="top-section">
    <!-- 缓存记录 -->
    <view class="cache-card">
      <view class="cache-row">
        <text class="cache-icon">☁️</text>
        <text class="cache-text" bindtap="onTapCacheText">缓存记录: <text class="cache-num">{{cacheCount}}</text> 条</text>
        <button class="cache-upload-btn {{isCenterUploading ? 'cache-upload-cancel' : ''}}" bindtap="uploadToCenter">
          {{isCenterUploading ? '⏸ 暂停上传' : '▶ 上传数据'}}
        </button>
      </view>
      <view class="cache-progress-line" wx:if="{{isCenterUploading || uploadedCount > 0}}">
        {{isCenterUploading ? '上传中' : ''}}{{uploadedCount > 0 ? ' | 已上传 ' + uploadedCount + ' 条' : ''}}{{gpsQueue.length > 0 ? ' | 队列 ' + gpsQueue.length + ' 条' : ''}}
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-bar">
      <button class="action-btn {{bluetoothConnected ? 'btn-disconnect' : 'btn-connect'}}" bindtap="{{bluetoothConnected ? 'disconnectBluetooth' : 'connectBluetooth'}}">
        {{bluetoothConnected ? '断开连接' : '连接蓝牙'}}
      </button>
      <button class="action-btn {{bluetoothConnected ? (isSyncing ? 'btn-stop-sync' : 'btn-start-sync') : 'btn-disabled'}}"
              bindtap="{{bluetoothConnected ? 'syncData' : ''}}">
        {{isSyncing ? '停止同步' : '开始同步'}}
      </button>
    </view>

    <!-- 设备信息卡片 -->
    <view class="device-card" wx:if="{{bluetoothConnected}}">
      <text class="device-bt">📡</text>
      <text class="device-name">{{connectedDeviceName}}</text>
      <view class="device-cmd-btn" bindtap="openCmdModalDirectly">
        <text>发送指令</text>
      </view>
    </view>

    <!-- 发送指令弹窗 -->
    <view class="cmd-modal" wx:if="{{showCmdModal}}">
      <view class="cmd-mask" bindtap="closeCmdModal"></view>
      <view class="cmd-dialog">
        <view class="cmd-close" bindtap="closeCmdModal">✕</view>
        <view class="cmd-title">{{cmdMode === 'synctime' ? '同步时间' : '发送指令'}}</view>

        <!-- 选择设备 -->
        <view class="cmd-label">目标设备</view>
        <picker mode="selector" range="{{cmdDeviceList}}" value="{{cmdDeviceIndex}}" bindchange="onCmdDeviceChange">
          <view class="cmd-picker">{{cmdDeviceList[cmdDeviceIndex] || '请选择设备'}}</view>
        </picker>

        <!-- 指令输入（同步时间模式隐藏） -->
        <block wx:if="{{cmdMode !== 'synctime'}}">
          <view class="cmd-label">指令内容</view>
          <textarea class="cmd-input" value="{{cmdText}}" placeholder="输入指令..." bindinput="onCmdInput" auto-height maxlength="-1" />
          <!-- 快捷指令 -->
          <view class="cmd-quick-label">快捷指令</view>
          <view class="cmd-quick-row">
            <button class="cmd-quick-btn {{cmdQuickSelected === 5 ? 'cmd-quick-btn-active' : ''}}" bindtap="onQuickReportGps">📍 上报GPS</button>
            <button class="cmd-quick-btn {{cmdQuickSelected === 7 ? 'cmd-quick-btn-active' : ''}}" bindtap="onQuickReport30Min">⏱️ 30分钟上报</button>
            <button class="cmd-quick-btn {{cmdQuickSelected === 10 ? 'cmd-quick-btn-active' : ''}}" bindtap="onQuickTrack">🛰️ 持续跟踪</button>
          </view>
        </block>
        <view class="cmd-synctime-hint" wx:else>
          <text>🕐 点击确定将以即时时间同步到设备</text>
        </view>

        <!-- 发送按钮 -->
        <button class="cmd-send-btn" bindtap="onCmdSend">发送指令</button>
      </view>
    </view>

    <!-- 扫描设备列表（未连接时显示） -->
    <view class="scan-panel" wx:if="{{devices.length > 0 && !bluetoothConnected}}">
      <view class="scan-title">
        {{bluetoothScanning ? '正在扫描设备...' : '扫描完成'}}（{{devices.length}}个）
      </view>
      <scroll-view class="scan-list" scroll-y>
        <view class="scan-item" wx:for="{{devices}}" wx:key="deviceId" bindtap="connectToDevice"
              data-deviceid="{{item.deviceId}}" data-devicename="{{item.name}}">
          <view class="scan-info">
            <text class="scan-name">{{item.name}}</text>
            <text class="scan-id">{{item.deviceId}}</text>
          </view>
          <text class="scan-rssi">{{item.RSSI}}dBm</text>
        </view>
      </scroll-view>
      <view class="scan-stop" wx:if="{{bluetoothScanning}}" bindtap="stopScanDevices">停止搜索</view>
    </view>
  </view>

  <!-- 接收/缓存数据列表（撑满剩余空间） -->
  <view class="recv-panel">
    <view class="recv-header" wx:if="{{bluetoothConnected}}">
      <text class="recv-icon">⬇</text>
      <text class="recv-label">接收数据</text>
      <view class="recv-filters">
        <text class="recv-filter-btn {{filterType === 'gps' ? 'recv-filter-on' : ''}}" bindtap="onToggleFilterGps">📍 GPS</text>
        <text class="recv-filter-btn {{filterType === 'time' ? 'recv-filter-on' : ''}}" bindtap="onToggleFilterTime">🕐 对时</text>
        <text class="recv-filter-btn {{filterType === 'battery' ? 'recv-filter-on' : ''}}" bindtap="onToggleFilterBattery">🔋 电量</text>
      </view>
      <text class="recv-count">{{displayList.length}} 条</text>
    </view>
    <view class="recv-header" wx:else>
      <text class="recv-icon">☁️</text>
      <text class="recv-label">缓存数据</text>
      <view class="recv-filters">
        <text class="recv-filter-btn {{filterType === 'gps' ? 'recv-filter-on' : ''}}" bindtap="onToggleFilterGps">📍 GPS</text>
        <text class="recv-filter-btn {{filterType === 'time' ? 'recv-filter-on' : ''}}" bindtap="onToggleFilterTime">🕐 对时</text>
        <text class="recv-filter-btn {{filterType === 'battery' ? 'recv-filter-on' : ''}}" bindtap="onToggleFilterBattery">🔋 电量</text>
      </view>
      <text class="recv-count">{{cacheDisplayList.length}} 条</text>
    </view>
    <scroll-view class="recv-scroll" scroll-y>
      <view class="record-item" wx:for="{{bluetoothConnected ? displayList : cacheDisplayList}}" wx:key="_key" style="background-color:{{item.bgColor}}" bindtap="onRecordTap" data-index="{{index}}">
        <view class="rec-row rec-row-time">
          <text class="rec-val rec-val-time">{{item.date}} {{item.time_part}}</text>
          <text class="rec-val rec-val-update" style="color:{{item.deviceColor}}" wx:if="{{item.upDateDevice && item.upDateDevice !== '-'}}">| {{item.upDateDevice}}<text wx:if="{{item.upDateDeviceAlias}}" class="rec-val-alias">({{item.upDateDeviceAlias}})</text></text>
        </view>
        <view class="rec-row rec-row-content">
          <text class="rec-icon-lora type-{{item.msgType}}">{{item.msgType === '1' ? '定位' : item.msgType === '2' ? '对时' : item.msgType === '3' ? '电量' : item.msgType === '5' ? '跟踪' : item.msgType === '6' ? '设置' : item.msgType}}</text>
          <text class="rec-val rec-val-lora">{{item.displayLorastr}}</text>
          <text class="rec-tap-arrow" wx:if="{{item.msgType === '1' || item.msgType === '5'}}">›</text>
        </view>
        <view class="rec-row rec-row-rssi" wx:if="{{item.rssi !== '' || item.snr !== ''}}">
          <text class="rec-val rec-val-rssi" wx:if="{{item.rssi !== ''}}">RSSI: {{item.rssi}}dBm</text>
          <text class="rec-val rec-val-snr" wx:if="{{item.snr !== ''}}">SNR: {{item.snr}}</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
