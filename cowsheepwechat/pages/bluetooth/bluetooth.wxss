/**bluetooth.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
  overflow: hidden;
}
.page-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

/* ========== 上部固定区 ========== */
.top-section {
  flex-shrink: 0;
}

/* 缓存记录卡片 */
.cache-card {
  margin: 20rpx 24rpx 12rpx;
  padding: 22rpx 28rpx;
  background: #fff;
  border-radius: 14rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.cache-row {
  display: flex;
  align-items: center;
}

.cache-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.cache-text {
  font-size: 30rpx;
  color: #333;
  padding: 4rpx 0;
}

.cache-num {
  color: #1989fa;
  font-weight: bold;
  margin: 0 4rpx;
}

.cache-upload-btn {
  margin-left: auto;
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  color: #666;
  background: #f0f2f5;
  border-radius: 34rpx;
  border: none;
}
.cache-upload-btn::after { border: none; }

.cache-upload-cancel {
  color: #fff;
  background: #e74c3c;
}

.cache-progress-line {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
  font-size: 24rpx;
  color: #999;
  text-align: center;
}

/* 操作按钮区 */
.action-bar {
  display: flex;
  padding: 8rpx 24rpx 16rpx;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  border-radius: 44rpx;
  border: none;
  padding: 0;
}
.action-btn::after { border: none; }

.btn-disconnect { background: #e74c3c; }
.btn-connect { background: #1989fa; }
.btn-start-sync { background: #ff9800; }
.btn-stop-sync { background: #e74c3c; }

.btn-disabled {
  background: #ccc !important;
  color: #999 !important;
}

/* 设备信息卡片 */
.device-card {
  margin: 0 24rpx 12rpx;
  padding: 20rpx 28rpx;
  background: #fff;
  border-radius: 14rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
  display: flex;
  align-items: center;
}

.device-bt {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.device-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

/* 扫描设备面板 */
.scan-panel {
  margin: 0 24rpx 12rpx;
  background: #fff;
  border-radius: 14rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.scan-title {
  font-size: 28rpx;
  color: #666;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.scan-list {
  max-height: 400rpx;
}

.scan-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid #fafafa;
}
.scan-item:last-child { border-bottom: none; }

.scan-info {
  flex: 1;
  min-width: 0;
}

.scan-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.scan-id {
  display: block;
  font-size: 22rpx;
  color: #aaa;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scan-rssi {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #1989fa;
  background: #eaf3ff;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-left: 16rpx;
}

.scan-stop {
  text-align: center;
  padding: 16rpx;
  font-size: 26rpx;
  color: #999;
  border-top: 1rpx solid #f5f5f5;
}

/* ========== 接收数据列表（flex:1 撑满底部） ========== */
.recv-panel {
  flex: 1;
  margin: 0 24rpx 12rpx;
  background: #fff;
  border-radius: 14rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
  display: flex;
  flex-direction: column;
  min-height: 200rpx;
}

.recv-header {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.recv-icon {
  font-size: 28rpx;
  margin-right: 6rpx;
}

.recv-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.recv-count {
  margin-left: auto;
  font-size: 26rpx;
  color: #999;
}

.recv-scroll {
  flex: 1;
  min-height: 0;
}

.recv-item {
  padding: 14rpx 24rpx;
  font-size: 32rpx;
  color: #444;
  word-break: break-all;
  line-height: 1.55;
  border-bottom: 1rpx solid #fafafa;
}
.recv-item:last-child { border-bottom: none; }
