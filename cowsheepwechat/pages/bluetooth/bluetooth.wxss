/**bluetooth.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
  overflow: hidden;
}
.page-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

/* ========== 上部固定区 ========== */
.top-section {
  flex-shrink: 0;
}

/* 缓存记录卡片 */
.cache-card {
  margin: 20rpx 24rpx 12rpx;
  padding: 22rpx 28rpx;
  background: #fff;
  border-radius: 14rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.cache-row {
  display: flex;
  align-items: center;
}

.cache-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.cache-text {
  font-size: 30rpx;
  color: #333;
  padding: 4rpx 0;
}

.cache-num {
  color: #1989fa;
  font-weight: bold;
  margin: 0 4rpx;
}

/* 自动上传按钮（带复选框视觉，勾选=自动上传模式，点击切换） */
.auto-upload {
  margin-left: auto;
  display: flex;
  align-items: center;
  height: 60rpx;
  padding: 0 26rpx;
  border-radius: 30rpx;
  background: #f0f2f5;
  border: 1rpx solid #e0e0e0;
}
.auto-checkbox {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  border: 2rpx solid #c8c9cc;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 10rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}
.auto-checkmark {
  color: #1989fa;
  font-size: 22rpx;
  line-height: 1;
}
.auto-upload-label {
  font-size: 26rpx;
  color: #333;
  white-space: nowrap;
}
/* 激活状态：蓝色高亮，勾选可见 */
.auto-upload-on {
  background: #1989fa;
  border-color: #1989fa;
}
.auto-upload-on .auto-checkbox {
  background: #fff;
  border-color: #fff;
}
.auto-upload-on .auto-upload-label {
  color: #fff;
  font-weight: bold;
}

/* 操作按钮区 */
.action-bar {
  display: flex;
  padding: 8rpx 24rpx 16rpx;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  border-radius: 44rpx;
  border: none;
  padding: 0;
}
.action-btn::after { border: none; }

.btn-disconnect { background: #e74c3c; }
.btn-connect { background: #1989fa; }
.btn-start-sync { background: #ff9800; }
.btn-stop-sync { background: #e74c3c; }

.btn-disabled {
  background: #ccc !important;
  color: #999 !important;
}

/* 设备信息卡片 */
.device-card {
  margin: 0 24rpx 12rpx;
  padding: 20rpx 28rpx;
  background: #fff;
  border-radius: 14rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
  display: flex;
  align-items: center;
}

.device-bt {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.device-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.device-cmd-btn {
  margin-left: auto;
  display: flex;
  align-items: center;
  padding: 10rpx 24rpx;
  font-size: 26rpx;
  color: #1989fa;
  background: #eaf3ff;
  border-radius: 30rpx;
}

/* ========== 发送指令弹窗 ========== */
.cmd-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cmd-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}

.cmd-dialog {
  position: relative;
  width: 660rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 36rpx 32rpx;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.15);
}

.cmd-close {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  font-size: 36rpx;
  color: #ccc;
  padding: 8rpx;
}

.cmd-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 28rpx;
  text-align: center;
}

.cmd-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.cmd-picker {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
  background: #f5f5f5;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.cmd-input {
  width: 100%;
  min-height: 120rpx;
  padding: 18rpx 24rpx;
  font-size: 26rpx;
  color: #333;
  background: #f5f5f5;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
  font-family: 'Courier New', monospace;
}

.cmd-quick-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.cmd-quick-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.cmd-quick-btn {
  flex: 0 0 calc((100% - 24rpx) / 3);
  height: 60rpx;
  line-height: 60rpx;
  font-size: 22rpx;
  padding: 0;
  border-radius: 10rpx;
  background: #f5f5f5;
  color: #666;
  border: 1rpx solid #e0e0e0;
  margin: 0;
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  box-sizing: border-box;
}

.cmd-quick-btn-active {
  background: #e3f2fd !important;
  color: #1989fa !important;
  border-color: #1989fa !important;
  font-weight: 600;
}

.cmd-synctime-hint {
  text-align: center;
  font-size: 26rpx;
  color: #ff9800;
  padding: 24rpx 0;
  margin-bottom: 28rpx;
  background: #fff8e1;
  border-radius: 12rpx;
}

.cmd-send-btn {
  width: 100%;
  height: 88rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  background: #1989fa;
  border-radius: 44rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1;
}
.cmd-send-btn::after { border: none; }

/* 扫描设备面板 */
.scan-panel {
  margin: 0 24rpx 12rpx;
  background: #fff;
  border-radius: 14rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.scan-title {
  font-size: 28rpx;
  color: #666;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.scan-list {
  max-height: 400rpx;
}

.scan-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid #fafafa;
}
.scan-item:last-child { border-bottom: none; }

.scan-info {
  flex: 1;
  min-width: 0;
}

.scan-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.scan-id {
  display: block;
  font-size: 22rpx;
  color: #aaa;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scan-rssi {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #1989fa;
  background: #eaf3ff;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-left: 16rpx;
}

.scan-stop {
  text-align: center;
  padding: 16rpx;
  font-size: 26rpx;
  color: #999;
  border-top: 1rpx solid #f5f5f5;
}

/* ========== 接收数据列表（flex:1 撑满底部） ========== */
.recv-panel {
  flex: 1;
  margin: 0 24rpx 12rpx;
  background: #fff;
  border-radius: 14rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
  display: flex;
  flex-direction: column;
  min-height: 200rpx;
}

.recv-header {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.recv-icon {
  font-size: 28rpx;
  margin-right: 6rpx;
}

.recv-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.recv-count {
  margin-left: auto;
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
}

.recv-filters {
  display: flex;
  gap: 10rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.recv-filter-btn {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  border: 1rpx solid #ddd;
  color: #999;
  background: #fff;
  white-space: nowrap;
}

.recv-filter-on {
  color: #fff;
  background: #1989fa;
  border-color: #1989fa;
}

.recv-scroll {
  flex: 1;
  min-height: 0;
}

/* 数据不足时也能上下滑动：内容至少撑满视口高度并留出底部余量，
   使 scroll-view 始终存在可滚动空间（无需加载新数据，仅保证滚动手感） */
.recv-list-wrap {
  min-height: 100%;
  box-sizing: content-box;
  padding-bottom: 100rpx;
}

/* ========== 数据记录列表（与设备详情记录样式一致） ========== */
.record-item {
  padding: 20rpx 24rpx;
  font-size: 32rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
  line-height: 1.6;
}
.record-item:last-child { border-bottom: none; }

.rec-row {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
}
.rec-row-time {
  padding-bottom: 0;
}
.rec-row-rssi {
  padding-top: 4rpx;
  justify-content: space-between;
}

.rec-val {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  word-break: break-all;
}
.rec-val-time {
  color: #555;
  font-weight: 500;
}
.rec-val-update {
  color: #888;
  font-size: 30rpx;
  font-weight: bold;
  flex-shrink: 0;
}
.rec-val-alias {
  font-size: 24rpx;
  font-weight: normal;
  color: #000;
}
.rec-val-lora {
  color: #1565c0;
  font-size: 32rpx;
}
.rec-val-rssi {
  font-size: 24rpx;
  flex-shrink: 0;
}
.rec-val-snr {
  font-size: 24rpx;
  flex-shrink: 0;
}

/* 定位记录点击箭头 */
.rec-tap-arrow {
  font-size: 40rpx;
  color: #1976d2;
  font-weight: 700;
  flex-shrink: 0;
  margin-left: 12rpx;
  line-height: 1;
}

/* 消息类型标签 */
.rec-icon-lora {
  display: inline-block;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  color: #fff;
  background: #999;
  margin-right: 10rpx;
  flex-shrink: 0;
  line-height: 1.6;
}
.rec-icon-lora.type-1 {
  background: #1976d2;
}
.rec-icon-lora.type-2 {
  background: #ff9500;
}
.rec-icon-lora.type-3 {
  background: #4CAF50;
}
.rec-icon-lora.type-5 {
  background: #8E24AA;
}
.rec-icon-lora.type-6 {
  background: #607D8B;
}
