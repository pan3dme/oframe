/**dtu-cmd.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.section-placeholder {
  height: 40rpx;
}

/* ===== 通用卡片 ===== */
.section-card {
  margin: 16rpx 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 8rpx;
  border-left: 6rpx solid #1989fa;
}

/* ===== 设备下拉 ===== */
.cmd-picker {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #333;
  box-sizing: border-box;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cmd-picker::after {
  content: '▼';
  font-size: 22rpx;
  color: #999;
}

/* ===== 指令输入 ===== */
.cmd-input {
  width: 100%;
  min-height: 160rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-bottom: 24rpx;
  font-family: 'Courier New', monospace;
  line-height: 1.6;
}

/* ===== 快捷按钮 ===== */
.quick-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.quick-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.quick-btn {
  flex: 0 0 calc((100% - 12rpx) / 2);
  height: 60rpx;
  line-height: 60rpx;
  font-size: 22rpx;
  padding: 0;
  border-radius: 10rpx;
  background: #f5f5f5;
  color: #666;
  border: 1rpx solid #e0e0e0;
  margin: 0;
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
}

.quick-btn.quick-active {
  background: #e3f2fd;
  color: #1989fa;
  border-color: #1989fa;
  font-weight: 600;
}

/* ===== 发送按钮 ===== */
.send-section {
  margin: 24rpx 24rpx;
}

.send-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #07c160;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 14rpx;
  padding: 0;
  margin: 0;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}

.send-btn:active {
  background: #06ad56;
}

/* ===== 发送日志 ===== */
.log-card {
  margin: 0 24rpx 16rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  max-height: 600rpx;
}

.log-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
  border-left: 6rpx solid #ff9500;
}

.log-list {
  max-height: 520rpx;
  overflow-y: auto;
}

.log-item {
  display: flex;
  align-items: flex-start;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #fafafa;
}

.log-time {
  font-size: 20rpx;
  color: #aaa;
  font-family: 'Courier New', monospace;
  white-space: nowrap;
  margin-right: 8rpx;
  min-width: 100rpx;
}

.log-type {
  font-size: 20rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.log-type-info {
  background: #e3f2fd;
  color: #1976d2;
}

.log-type-success {
  background: #e8f5e9;
  color: #388e3c;
}

.log-type-error {
  background: #ffebee;
  color: #d32f2f;
}

.log-text {
  font-size: 22rpx;
  color: #555;
  word-break: break-all;
  line-height: 1.5;
}
