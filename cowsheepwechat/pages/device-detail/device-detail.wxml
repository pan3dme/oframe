<!--device-detail.wxml-->
<navigation-bar title="{{navTitle}}" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<block wx:if="{{deviceInfo}}">
  <!-- 设备头部卡片：左图片 + 右基本信息（固定不动） -->
  <view class="detail-header" wx:if="{{!hideDeviceInfo}}">
    <!-- 左边：设备图片 -->
    <view class="pic-area" bindtap="onPreviewImage">
      <image class="detail-pic" wx:if="{{deviceInfo.picurl}}" src="{{deviceInfo.picurl}}" mode="aspectFill" />
      <view class="detail-pic-placeholder" wx:else>
        <view class="placeholder-icon">📡</view>
        <text class="placeholder-text">点击上传</text>
      </view>
    </view>

    <!-- 右边：基本信息 -->
    <view class="header-info">
      <view class="header-title-row">
        <text class="header-title">{{deviceInfo.deviceid || deviceInfo.deviceId}}<block wx:if="{{deviceInfo.rename}}"> ({{deviceInfo.rename}})</block></text>
      </view>
      <view class="header-info-grid">
        <view class="hi-item">
          <text class="hi-label">上报周期</text>
          <text class="hi-value">
            <text class="{{deviceInfo.inPowerOn ? 'hi-val-main' : 'hi-val-dim'}}">{{deviceInfo.reportInterval || '-'}}分钟</text>
            <block wx:if="{{deviceInfo.mainPeriod}}">
              <text class="{{deviceInfo.inPowerOn ? 'hi-val-dim' : 'hi-val-main'}}">（{{deviceInfo.mainPeriod * 10}}分钟）</text>
            </block>
          </text>
          <text class="hi-value-abnormal" wx:if="{{reportIntervalAbnormal}}">{{reportActualInterval}}</text>
        </view>
        <view class="hi-item">
          <text class="hi-label">开机时间</text>
          <text class="hi-value">{{deviceInfo.powerOnTime || '-'}}</text>
        </view>
        <!-- 中继设备(有ProductKey)为太阳能供电，不显示GPS时间（中继无GPS定位） -->
        <view class="hi-item" wx:if="{{!deviceInfo.ProductKey}}">
          <text class="hi-label">GPS时间</text>
          <text class="hi-value">{{deviceInfo.gpsReportTime || '-'}}</text>
        </view>
        <!-- 中继设备(有ProductKey)为太阳能供电，无法判断电量/换电，不显示上次换电 -->
        <view class="hi-item">
          <block wx:if="{{!deviceInfo.ProductKey}}">
            <text class="hi-label">上次换电</text>
            <text class="hi-value {{deviceInfo.swapTimeRel ? 'hi-value-highlight' : ''}}">{{deviceInfo.swapTimeRel || '-'}}</text>
          </block>
          <view class="hi-item-links {{deviceInfo.ProductKey ? 'hi-item-links-relay' : ''}}">
            <view class="send-cmd-link" bindtap="onSendCmdTap">
              <text class="send-cmd-icon">📤</text>
            </view>
            <view class="get-location-link" wx:if="{{!deviceInfo.ProductKey}}" bindtap="onGetLocationTap">
              <text class="get-location-icon">📍</text>
            </view>
            <view class="track-link" wx:if="{{!deviceInfo.ProductKey}}" bindtap="onViewTrackTap">
              <text class="track-icon">🗺</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 右上角操作图标 -->
    <view class="header-actions" wx:if="{{isAdmin}}">
      <view class="header-icon-btn" bindtap="onDetailEdit">
        <text class="header-icon">✏️</text>
      </view>
      <view class="header-icon-btn" wx:if="{{!deviceInfo.ProductKey}}" bindtap="onDetailBind">
        <text class="header-icon">🔗</text>
      </view>
    </view>
  </view>

  <!-- 轨迹记录标题（固定不动）：设备详情页点击"数据记录"打开下一页查看该设备数据记录 -->
  <view class="track-date-bar {{!hideDeviceInfo ? 'track-date-bar-btn' : ''}}" wx:if="{{showRecordTable}}" bindtap="onOpenRecordsTap">
    <text>数据记录 ({{recordList.length}}条)</text>
    <text class="track-date-arrow" wx:if="{{!hideDeviceInfo}}">›</text>
  </view>

  <!-- 轨迹数据列表（可滑动刷新 + 无限加载） -->
  <scroll-view
    class="record-scroll"
    scroll-y="{{true}}"
    refresher-enabled="{{true}}"
    refresher-triggered="{{isRefreshing}}"
    bindrefresherrefresh="onRefreshRecords"
    bindscrolltolower="onLoadMoreRecords"
    lower-threshold="80"
  >
    <view class="msg-panel" wx:if="{{showRecordTable}}">
      <view class="record-list">
        <view class="record-item" wx:for="{{recordList}}" wx:key="_key" style="background-color:{{item.bgColor}}" bindtap="onRecordTap" data-index="{{index}}">
          <view class="rec-row rec-row-time">
            <text class="rec-val rec-val-time">{{item.date}} {{item.time_part}}</text>
            <text class="rec-val rec-val-update" style="color:{{item.deviceColor}}" wx:if="{{item.upDateDevice && item.upDateDevice !== '-'}}">| {{item.upDateDevice}}<text wx:if="{{item.upDateDeviceAlias}}" class="rec-val-alias">({{item.upDateDeviceAlias}})</text></text>
          </view>
          <view class="rec-row rec-row-content">
            <text class="rec-icon-lora type-{{item.msgType}}">{{item.msgType === '1' ? '定位' : item.msgType === '2' ? '对时' : item.msgType === '3' ? '电量' : item.msgType === '5' ? '跟踪' : item.msgType === '6' ? '设置' : item.msgType}}</text>
            <text class="rec-val rec-val-lora">{{item.displayLorastr}}</text>
            <text class="rec-tap-arrow" wx:if="{{item.msgType === '1' || item.msgType === '5'}}">›</text>
          </view>
          <view class="rec-row rec-row-rssi" wx:if="{{item.rssi !== '' || item.snr !== ''}}">
            <text class="rec-val rec-val-rssi" wx:if="{{item.rssi !== ''}}">RSSI: {{item.rssi}}dBm</text>
            <text class="rec-val rec-val-snr" wx:if="{{item.snr !== ''}}">SNR: {{item.snr}}</text>
          </view>
        </view>
      </view>
      <!-- 加载更多状态 -->
      <view class="load-more-tip" wx:if="{{isLoadingMore}}">加载中...</view>
      <view class="load-more-tip" wx:elif="{{!hasMore && recordList.length > 0}}">— 没有更多了 —</view>
    </view>
    <view class="empty-tip" wx:else>暂无轨迹记录</view>
  </scroll-view>
</block>

<!-- 加载中 -->
<view class="empty-tip" wx:else>加载中...</view>

<!-- 连接牛羊弹窗 -->
<view class="modal" wx:if="{{showBindModal}}">
  <view class="modal-mask" bindtap="onBindClose"></view>
  <view class="modal-dialog">
    <view class="modal-close" bindtap="onBindClose">✕</view>
    <view class="modal-title">连接牛羊</view>

    <view class="modal-label">绑定设备：{{bindDeviceId}}</view>

    <view class="modal-label">选择牛羊</view>
    <picker mode="selector" range="{{livestockNames}}" value="{{bindNameIndex}}" bindchange="onBindNameChange">
      <view class="modal-picker">{{livestockNames[bindNameIndex] || '请新增牛羊'}}</view>
    </picker>

    <view class="modal-btns">
      <button class="modal-btn modal-btn-gray" bindtap="onBindClose">取消</button>
      <button class="modal-btn modal-btn-confirm" bindtap="onBindConfirm">确认连接</button>
    </view>
  </view>
</view>

<!-- 编辑设备弹窗 -->
<view class="modal" wx:if="{{showEditModal}}">
  <view class="modal-mask" bindtap="onEditClose"></view>
  <view class="modal-dialog">
    <view class="modal-close" bindtap="onEditClose">✕</view>
    <view class="modal-title">编辑设备</view>

    <!-- 设备图片 -->
    <view class="modal-label">设备图片</view>
    <view class="edit-pic-wrap" bindtap="onEditPic">
      <image class="edit-pic-img" wx:if="{{editPicurl}}" src="{{editPicurl}}" mode="aspectFill" />
      <view class="edit-pic-placeholder" wx:else>📡 点击选图</view>
    </view>

    <!-- 别名 -->
    <view class="modal-label">别名</view>
    <input class="modal-input"
      value="{{editRename}}"
      placeholder="请输入别名"
      bindinput="onEditRenameInput" />

    <!-- 中继配置：设备无 ProductKey 时显示"设为中继"按钮 -->
    <view class="modal-set-relay" wx:if="{{!showRelayFields}}" bindtap="onSetRelayTap">
      <text class="modal-set-relay-icon">📡</text>
      <text class="modal-set-relay-text">设为中继</text>
    </view>

    <!-- 中继配置输入框（已有 ProductKey 直接显示，或点击"设为中继"后展开，弹框自动变长） -->
    <block wx:if="{{showRelayFields}}">
      <!-- ProductKey -->
      <view class="modal-label">ProductKey</view>
      <input class="modal-input"
        value="{{editProductKey}}"
        placeholder="请输入ProductKey"
        bindinput="onEditProductKeyInput" />

      <!-- DeviceName -->
      <view class="modal-label">DeviceName</view>
      <input class="modal-input"
        value="{{editDeviceName}}"
        placeholder="请输入DeviceName"
        bindinput="onEditDeviceNameInput" />

      <!-- DeviceSecret -->
      <view class="modal-label">DeviceSecret</view>
      <input class="modal-input"
        value="{{editDeviceSecret}}"
        placeholder="请输入DeviceSecret"
        bindinput="onEditDeviceSecretInput" />
    </block>

    <!-- 是否可见 -->
    <view class="modal-label">是否可见</view>
    <switch checked="{{editVisible}}" bindchange="onEditVisibleChange" class="modal-switch" />

    <view class="modal-btns">
      <button class="modal-btn modal-btn-gray" bindtap="onEditClose">取消</button>
      <button class="modal-btn modal-btn-confirm" bindtap="onEditConfirm">确认修改</button>
    </view>
  </view>
</view>



