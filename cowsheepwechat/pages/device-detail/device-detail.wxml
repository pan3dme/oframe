<!--device-detail.wxml-->
<navigation-bar title="设备详情" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <block wx:if="{{deviceInfo}}">
    <!-- 设备头部卡片：左图片 + 右基本信息 -->
    <view class="detail-header">
      <!-- 左边：设备图片 -->
      <view class="pic-area" bindtap="onPreviewImage">
        <image class="detail-pic" wx:if="{{deviceInfo.picurl}}" src="{{deviceInfo.picurl}}" mode="aspectFill" />
        <view class="detail-pic-placeholder" wx:else>
          <view class="placeholder-icon">📡</view>
          <text class="placeholder-text">点击上传</text>
        </view>
      </view>

      <!-- 右边：基本信息 -->
      <view class="header-info">
        <text class="header-title">id: {{deviceInfo.deviceId}}<text wx:if="{{deviceInfo.rename}}">({{deviceInfo.rename}})</text></text>
        <view class="header-info-grid">
          <view class="hi-item">
            <text class="hi-label">设备编码</text>
            <text class="hi-value">{{deviceInfo.device_key || '-'}}</text>
          </view>
          <view class="hi-item">
            <text class="hi-label">绑定牛羊</text>
            <text class="hi-value hi-value-highlight">{{deviceInfo.bindName || deviceInfo.link_cowsheep_id || '未绑定'}}</text>
          </view>
          <view class="hi-item">
            <text class="hi-label">ProductKey</text>
            <text class="hi-value">{{deviceInfo.ProductKey || '-'}}</text>
          </view>
          <view class="hi-item">
            <text class="hi-label">DeviceName</text>
            <text class="hi-value">{{deviceInfo.DeviceName || '-'}}</text>
          </view>
          <view class="hi-item">
            <text class="hi-label">记录时间</text>
            <text class="hi-value">{{deviceInfo.date}} {{deviceInfo.time_part}}</text>
          </view>
          <view class="hi-item">
            <text class="hi-label">上次换电</text>
            <text class="hi-value">{{deviceInfo.chargeTime || '-'}}</text>
            <view class="send-cmd-link" bindtap="onSendCmdTap">
              <text class="send-cmd-icon">📤</text>
            </view>
            <view class="get-location-link" bindtap="onGetLocationTap">
              <text class="get-location-icon">📍</text>
            </view>
            <view class="battery-link" bindtap="onBatteryAnalysisTap">
              <text class="battery-icon">🔋</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 右上角操作图标 -->
      <view class="header-actions" wx:if="{{isAdmin}}">
        <view class="header-icon-btn" bindtap="onDetailEdit">
          <text class="header-icon">✏️</text>
        </view>
        <view class="header-icon-btn" bindtap="onDetailBind">
          <text class="header-icon">🔗</text>
        </view>
      </view>
    </view>

    <!-- 切换日期 / 轨迹地图按钮 -->
    <view class="record-btn" bindtap="onViewRecords">
      <text>切换日期 / 轨迹地图</text>
    </view>

    <!-- 轨迹数据列表（随机背景色，类似蓝牙接收数据） -->
    <view class="msg-panel" wx:if="{{showRecordTable}}">
      <view class="track-date-bar">{{trackDate || '全部'}} 轨迹记录 ({{recordList.length}}条)</view>
      <view class="record-list">
        <view class="record-item" wx:for="{{recordList}}" wx:key="rawTime" style="background-color:{{item.bgColor}}">
          <view class="rec-row rec-row-time">
            <text class="rec-val rec-val-time">{{item.date}} {{item.time_part}}</text>
            <text class="rec-val rec-val-update" style="color:{{item.deviceColor}}" wx:if="{{item.upDateDevice && item.upDateDevice !== '-'}}">| {{item.upDateDevice}}</text>
          </view>
          <view class="rec-row rec-row-content">
            <text class="rec-icon-lora type-{{item.msgType}}">{{item.msgType === '1' ? '定位' : item.msgType === '2' ? '对时' : item.msgType === '3' ? '电量' : item.msgType}}</text>
            <text class="rec-val rec-val-lora">{{item.lorastr}}</text>
          </view>
          <view class="rec-row rec-row-rssi" wx:if="{{item.rssi !== '' || item.snr !== ''}}">
            <text class="rec-val rec-val-rssi" wx:if="{{item.rssi !== ''}}">RSSI: {{item.rssi}}dBm</text>
            <text class="rec-val rec-val-snr" wx:if="{{item.snr !== ''}}">SNR: {{item.snr}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 加载中 -->
  <view class="empty-tip" wx:else>加载中...</view>
</scroll-view>

<!-- 连接牛羊弹窗 -->
<view class="modal" wx:if="{{showBindModal}}">
  <view class="modal-mask" bindtap="onBindClose"></view>
  <view class="modal-dialog">
    <view class="modal-close" bindtap="onBindClose">✕</view>
    <view class="modal-title">连接牛羊</view>

    <view class="modal-label">绑定设备：{{bindDeviceId}}</view>

    <view class="modal-label">选择牛羊</view>
    <picker mode="selector" range="{{livestockNames}}" value="{{bindNameIndex}}" bindchange="onBindNameChange">
      <view class="modal-picker">{{livestockNames[bindNameIndex] || '请新增牛羊'}}</view>
    </picker>

    <view class="modal-btns">
      <button class="modal-btn modal-btn-gray" bindtap="onBindClose">取消</button>
      <button class="modal-btn modal-btn-confirm" bindtap="onBindConfirm">确认连接</button>
    </view>
  </view>
</view>

<!-- 编辑设备弹窗 -->
<view class="modal" wx:if="{{showEditModal}}">
  <view class="modal-mask" bindtap="onEditClose"></view>
  <view class="modal-dialog">
    <view class="modal-close" bindtap="onEditClose">✕</view>
    <view class="modal-title">编辑设备</view>

    <!-- 设备图片 -->
    <view class="modal-label">设备图片</view>
    <view class="edit-pic-wrap" bindtap="onEditPic">
      <image class="edit-pic-img" wx:if="{{editPicurl}}" src="{{editPicurl}}" mode="aspectFill" />
      <view class="edit-pic-placeholder" wx:else>📡 点击选图</view>
    </view>

    <!-- 设备编码 -->
    <view class="modal-label">设备编码</view>
    <input class="modal-input"
      value="{{editDeviceCode}}"
      placeholder="请输入设备编码"
      bindinput="onEditDeviceCodeInput" />

    <!-- 别名 -->
    <view class="modal-label">别名</view>
    <input class="modal-input"
      value="{{editRename}}"
      placeholder="请输入别名"
      bindinput="onEditRenameInput" />

    <!-- ProductKey -->
    <view class="modal-label">ProductKey</view>
    <input class="modal-input"
      value="{{editProductKey}}"
      placeholder="请输入ProductKey"
      bindinput="onEditProductKeyInput" />

    <!-- DeviceName -->
    <view class="modal-label">DeviceName</view>
    <input class="modal-input"
      value="{{editDeviceName}}"
      placeholder="请输入DeviceName"
      bindinput="onEditDeviceNameInput" />

    <!-- DeviceSecret -->
    <view class="modal-label">DeviceSecret</view>
    <input class="modal-input"
      value="{{editDeviceSecret}}"
      placeholder="请输入DeviceSecret"
      bindinput="onEditDeviceSecretInput" />

    <!-- 是否隐藏 -->
    <view class="modal-label">是否隐藏</view>
    <switch checked="{{editVisible}}" bindchange="onEditVisibleChange" class="modal-switch" />

    <view class="modal-btns">
      <button class="modal-btn modal-btn-gray" bindtap="onEditClose">取消</button>
      <button class="modal-btn modal-btn-confirm" bindtap="onEditConfirm">确认修改</button>
    </view>
  </view>
</view>

<!-- 设备轨迹日期选择弹窗 -->
<view class="track-modal" wx:if="{{showTrackModal}}">
  <view class="track-mask" bindtap="onTrackClose"></view>
  <view class="track-dialog">
    <view class="track-close" bindtap="onTrackClose">✕</view>
    <view class="track-title">查看设备轨迹</view>
    <view class="track-subtitle">设备：{{deviceId}}</view>
    <view class="track-date-label">选择日期</view>
    <picker mode="date" value="{{trackDate}}" bindchange="onTrackDateChange">
      <view class="track-date-picker">{{trackDate}}</view>
    </picker>
    <view class="track-btns">
      <button class="track-btn track-btn-confirm" bindtap="onTrackConfirm">列出数据</button>
      <button class="track-btn track-btn-map" bindtap="onTrackShowMap">轨迹地图</button>
    </view>
  </view>
</view>
