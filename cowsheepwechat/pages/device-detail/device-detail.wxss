/**device-detail.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f0f2f5;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

/* ========== 轨迹可滑动区域 ========== */
.record-scroll {
  flex: 1;
  height: 0;
}

/* ========== 设备头部卡片：左图片 + 右基本信息 ========== */
.detail-header {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin: 24rpx 24rpx 0;
  background: linear-gradient(135deg, #1a73e8 0%, #1565c0 100%);
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(21, 101, 192, 0.25);
}

/* 左边：设备图片 */
.pic-area {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 24rpx;
}
.detail-pic {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}
.detail-pic-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.placeholder-icon {
  font-size: 52rpx;
  line-height: 1;
}
.placeholder-text {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 4rpx;
}

/* 右边：基本信息 */
.header-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.header-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  word-break: break-all;
  line-height: 1.5;
  flex: 1;
  min-width: 0;
}

.header-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.header-dormant-tag {
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
  white-space: nowrap;
  flex-shrink: 0;
  margin-left: 16rpx;
  background: rgba(255, 255, 255, 0.25);
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.4);
}

.header-info-grid {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.hi-item {
  display: flex;
  align-items: center;
}
.hi-label {
  width: 130rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.65);
  flex-shrink: 0;
}
.hi-value {
  flex: 1;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  word-break: break-all;
  line-height: 1.5;
}
/* 上报周期当前生效区间：白色高亮；另一区间灰色弱化 */
.hi-val-main {
  color: #ffffff;
}
.hi-val-dim {
  color: rgba(255, 255, 255, 0.4);
}
.hi-value-abnormal {
  flex-shrink: 0;
  margin-left: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #ff4d4f;
}
.send-cmd-link {
  flex-shrink: 0;
  margin-left: 8rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  transition: all 0.2s;
}
.send-cmd-link:active {
  transform: scale(0.85);
  background: rgba(255, 255, 255, 0.4);
}
.send-cmd-icon {
  font-size: 26rpx;
  line-height: 1;
}
.get-location-link {
  flex-shrink: 0;
  margin-left: 8rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  transition: all 0.2s;
}
.get-location-link:active {
  transform: scale(0.85);
  background: rgba(255, 255, 255, 0.4);
}
.get-location-icon {
  font-size: 26rpx;
  line-height: 1;
}
.track-link {
  flex-shrink: 0;
  margin-left: 8rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  transition: all 0.2s;
}
.track-link:active {
  transform: scale(0.85);
  background: rgba(255, 255, 255, 0.4);
}
.track-icon {
  font-size: 26rpx;
  line-height: 1;
}
.hi-value-highlight {
  color: #a7f0ba;
  font-weight: 500;
}
.hi-item-links {
  display: flex;
  align-items: center;
}
.hi-item-links-relay {
  margin-left: auto;
}

/* ========== 右上角操作图标 ========== */
.header-actions {
  position: absolute;
  top: 0;
  right: 0;
  display: flex;
  gap: 4rpx;
  padding: 16rpx 16rpx 0 0;
}
.header-icon-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}
.header-icon-btn:active {
  transform: scale(0.9);
  background: rgba(255, 255, 255, 0.4);
}
.header-icon {
  font-size: 28rpx;
}

/* ========== 基本信息卡片 ========== */
.info-card {
  margin: 0 24rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 28rpx 16rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.info-grid {
  display: flex;
  flex-direction: column;
}
.info-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
}
.info-item:last-child {
  border-bottom: none;
  padding-bottom: 8rpx;
}

.info-label {
  width: 140rpx;
  font-size: 28rpx;
  color: #999;
  flex-shrink: 0;
  line-height: 1.5;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  word-break: break-all;
  line-height: 1.5;
  text-align: right;
}

.info-value-highlight {
  color: #07c160;
  font-weight: 500;
}

.info-value-lora {
  font-size: 26rpx;
  color: #1565c0;
}

/* ========== 切换日期按钮 ========== */
.record-btn {
  margin: 8rpx 24rpx 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 16rpx rgba(102, 126, 234, 0.3);
}
.record-btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

/* 空状态 */
.empty-tip {
  text-align: center;
  font-size: 28rpx;
  color: #bbb;
  padding: 100rpx 0;
}

/* ========== 设备轨迹日期选择弹窗 ========== */
.track-modal {
  position: fixed;
  z-index: 999;
  left: 0; right: 0; top: 0; bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.track-mask {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}
.track-dialog {
  position: relative;
  z-index: 2;
  width: 620rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 36rpx 32rpx;
}
.track-close {
  position: absolute;
  top: 16rpx; right: 24rpx;
  font-size: 36rpx;
  color: #999;
  padding: 8rpx;
}
.track-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  text-align: center;
  margin-bottom: 24rpx;
}
.track-subtitle {
  font-size: 30rpx;
  color: #888;
  text-align: center;
  margin-bottom: 28rpx;
  word-break: break-all;
}
.track-date-label {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 12rpx;
}
.track-date-picker {
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 34rpx;
  color: #333;
  margin-bottom: 32rpx;
}
.track-btns {
  display: flex;
  gap: 20rpx;
}
.track-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 0;
  border: none;
  margin: 0;
  box-sizing: border-box;
}
.track-btn::after {
  border: none;
}
.track-btn-gray {
  background: #f0f0f0;
  color: #666;
}
.track-btn-confirm {
  background: #07c160;
  color: #fff;
}
.track-btn-map {
  background: #1565c0;
  color: #fff;
}

/* ========== 轨迹数据列表（卡片式，随机背景） ========== */
.msg-panel {
  margin: 0 24rpx 0;
  border-radius: 0 0 16rpx 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.track-date-bar {
  font-size: 28rpx;
  color: #555;
  padding: 16rpx 20rpx;
  margin: 24rpx 24rpx 0;
  background: #fff;
  text-align: center;
  font-weight: 600;
  border-bottom: 1rpx solid #f0f0f0;
  border-radius: 16rpx 16rpx 0 0;
}

/* 设备详情页"数据记录"入口：整行可点击，左侧标题 + 右侧箭头 */
.track-date-bar-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.track-date-bar-btn:active {
  background: #eef4fb;
}
.track-date-arrow {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1;
  color: #1565c0;
}

.record-list {
  border-radius: 0;
  overflow: hidden;
}

.record-item {
  padding: 20rpx 24rpx;
  font-size: 32rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
  line-height: 1.6;
}
.record-item:last-child {
  border-bottom: none;
}

.rec-row {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
}

.rec-row-time {
  padding-bottom: 0;
}

.rec-row-content {
}

.rec-icon {
  width: 48rpx;
  font-size: 32rpx;
  flex-shrink: 0;
  text-align: center;
  line-height: 1;
}

.rec-val {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  word-break: break-all;
}

.rec-val-time {
  color: #555;
  font-weight: 500;
}

.rec-val-update {
  color: #888;
  font-size: 30rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.rec-val-alias {
  font-size: 24rpx;
  font-weight: normal;
  color: #000;
}

.rec-val-lora {
  color: #1565c0;
  font-size: 32rpx;
}

/* 定位记录点击箭头 */
.rec-tap-arrow {
  font-size: 40rpx;
  color: #1976d2;
  font-weight: 700;
  flex-shrink: 0;
  margin-left: 12rpx;
  line-height: 1;
}

/* RSSI / SNR 行 */
.rec-row-rssi {
  padding-top: 4rpx;
  justify-content: space-between;
}
.rec-val-rssi {
  font-size: 24rpx;
  flex-shrink: 0;
}
.rec-val-snr {
  font-size: 24rpx;
  flex-shrink: 0;
}

/* 加载更多提示 */
.load-more-tip {
  text-align: center;
  font-size: 26rpx;
  color: #999;
  padding: 24rpx 0;
  background: #fff;
}

.rec-icon-lora {
  display: inline-block;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  color: #fff;
  background: #999;
  margin-right: 10rpx;
  flex-shrink: 0;
  line-height: 1.6;
}
.rec-icon-lora.type-1 {
  background: #1976d2;
}
.rec-icon-lora.type-2 {
  background: #ff9500;
}
.rec-icon-lora.type-3 {
  background: #4CAF50;
}
.rec-icon-lora.type-5 {
  background: #8E24AA;
}
.rec-icon-lora.type-6 {
  background: #607D8B;
}

/* 类型标签 */
.type-tag {
  display: inline-block;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  color: #fff;
  background: #999;
  margin-left: 12rpx;
  flex-shrink: 0;
  line-height: 1.6;
}
.type-tag.type-1 {
  background: #1976d2;
}
.type-tag.type-2 {
  background: #ff9500;
}
.type-tag.type-3 {
  background: #4CAF50;
}
.type-tag.type-5 {
  background: #8E24AA;
}

/* ========== 弹窗（编辑/连接） ========== */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
}
.modal-dialog {
  position: relative;
  width: 600rpx;
  max-height: 85vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 20rpx;
  padding: 50rpx 40rpx 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.15);
}
.modal-close {
  position: absolute;
  top: 16rpx;
  right: 24rpx;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 32rpx;
  color: #999;
  border-radius: 50%;
  background: #f5f5f5;
}
.modal-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #333;
  text-align: center;
  margin-bottom: 28rpx;
}
.modal-label {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 12rpx;
}
.modal-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 34rpx;
  box-sizing: border-box;
  margin-bottom: 28rpx;
}
.modal-switch {
  margin-bottom: 28rpx;
  transform: scale(0.9);
}
.modal-picker {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 34rpx;
  color: #333;
  box-sizing: border-box;
  margin-bottom: 28rpx;
}
.modal-btns {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 10rpx;
}
.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  padding: 0;
}
.modal-btn-confirm {
  background: #1565c0;
  color: #fff;
}
.modal-btn-gray {
  background: #999;
  color: #fff;
}

/* 编辑弹窗-设为中继（设备无 ProductKey 时显示，点击展开中继配置输入框） */
.modal-set-relay {
  align-self: center;
  width: 50%;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 28rpx;
  border: 2rpx dashed #1565c0;
  border-radius: 12rpx;
  background: #f0f6ff;
  box-sizing: border-box;
}
.modal-set-relay:active {
  opacity: 0.75;
}
.modal-set-relay-icon {
  font-size: 36rpx;
  line-height: 1;
}
.modal-set-relay-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #1565c0;
}

/* 编辑弹窗-图片 */
.edit-pic-wrap {
  width: 200rpx;
  height: 200rpx;
  border-radius: 14rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
  overflow: hidden;
  border: 2rpx dashed #ccc;
}
.edit-pic-wrap:active {
  opacity: 0.7;
}
.edit-pic-img {
  width: 100%;
  height: 100%;
}
.edit-pic-placeholder {
  font-size: 32rpx;
  color: #999;
  text-align: center;
}
.edit-readonly {
  width: 100%;
  min-height: 80rpx;
  line-height: 80rpx;
  padding: 0 24rpx;
  font-size: 34rpx;
  color: #888;
  background: #f5f5f5;
  border-radius: 12rpx;
  box-sizing: border-box;
  margin-bottom: 28rpx;
}
