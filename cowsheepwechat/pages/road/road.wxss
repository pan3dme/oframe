/* road.wxss - 道路管理样式 */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

/* ========== 工具栏 ========== */
.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.toolbar-count {
  font-size: 26rpx;
  color: #999;
}

.toolbar-btn {
  background: #07c160;
  color: #fff;
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-weight: 600;
}

.toolbar-btn:active {
  opacity: 0.8;
}

/* ========== 滚动区 ========== */
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

/* ========== 加载/空状态 ========== */
.loading-tip,
.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #07c160;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 16rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #bbb;
  margin-top: 8rpx;
}

/* ========== 道路列表 ========== */
.road-list {
  padding: 16rpx 20rpx;
}

.road-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.road-item:active {
  background: #f9f9f9;
}

/* 序号 */
.item-index {
  font-size: 30rpx;
  color: #666;
  font-weight: 700;
  width: 56rpx;
  text-align: center;
  flex-shrink: 0;
  margin-right: 12rpx;
}

.road-info {
  flex: 1;
  min-width: 0;
}

.road-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.road-id {
  font-size: 22rpx;
  color: #1989fa;
  margin-bottom: 6rpx;
}

.road-desc {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 6rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.road-points {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.road-time {
  font-size: 20rpx;
  color: #bbb;
}

.road-actions {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.road-action-btn {
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  border: 1rpx solid #ddd;
  color: #666;
  margin-bottom: 12rpx;
  text-align: center;
  display: block;
}

.road-action-map {
  color: #1989fa;
  border-color: #1989fa;
}

.road-action-map:active {
  background: #1989fa;
  color: #fff;
}

.road-action-delete {
  color: #e74c3c;
  border-color: #e74c3c;
}

.road-action-delete:active {
  background: #e74c3c;
  color: #fff;
}

/* ========== 弹窗 ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
}

.modal {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  z-index: 101;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  text-align: center;
  margin-bottom: 28rpx;
}

.modal-field {
  margin-bottom: 20rpx;
}

.modal-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.required {
  color: #e74c3c;
}

.modal-input {
  width: 100%;
  height: 72rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 10rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.modal-picker {
  width: 100%;
  height: 72rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 10rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  background: #fff;
}

.modal-picker-val {
  font-size: 28rpx;
  color: #333;
  line-height: 72rpx;
}

.modal-textarea {
  width: 100%;
  min-height: 120rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.modal-textarea-small {
  min-height: 80rpx;
}

/* ========== 路径点行 ========== */
.path-row {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
}

.path-textarea {
  flex: 1;
  min-height: 72rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 24rpx;
}

.path-btn {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #1989fa, #0d6efd);
  color: #fff;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.path-btn:active {
  opacity: 0.8;
}

.path-btn-icon {
  font-size: 36rpx;
  line-height: 1;
  margin-bottom: 2rpx;
}

.path-btn-label {
  font-size: 22rpx;
}

.path-hint {
  font-size: 22rpx;
  color: #07c160;
  margin-top: 8rpx;
}

.modal-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 30rpx;
  border-radius: 40rpx;
  font-weight: 600;
}

.modal-btn-cancel {
  background: #f5f5f5;
  color: #666;
}

.modal-btn-confirm {
  background: #07c160;
  color: #fff;
}

.modal-btn:active {
  opacity: 0.8;
}
