/* road/record/record.wxss */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #000;
}

.record-wrap {
  flex: 1;
  position: relative;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.record-map {
  flex: 1;
  width: 100%;
}

/* ========== 状态指示器 ========== */
.record-status {
  position: absolute;
  top: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(0, 0, 0, 0.75);
  color: #fff;
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  z-index: 20;
  backdrop-filter: blur(8rpx);
}

.record-status.recording {
  border: 2rpx solid #ff4444;
}

.record-status.stopped {
  border: 2rpx solid #07c160;
}

.status-pulse {
  width: 16rpx;
  height: 16rpx;
  background: #ff4444;
  border-radius: 50%;
  animation: pulse 1s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(1.5); }
}

/* ========== 空状态引导 ========== */
.record-empty-hint {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(0, 0, 0, 0.7);
  color: #fff;
  padding: 40rpx 48rpx;
  border-radius: 20rpx;
  z-index: 15;
  backdrop-filter: blur(8rpx);
}

.hint-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.hint-text {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.hint-sub {
  font-size: 22rpx;
  color: #bbb;
}

/* ========== 底部控制栏 ========== */
.record-bar {
  position: relative;
  padding: 24rpx 32rpx 36rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.bar-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  font-weight: 700;
  transition: all 0.15s;
}

.bar-btn:active {
  opacity: 0.85;
  transform: scale(0.97);
}

.bar-btn-start {
  background: linear-gradient(135deg, #ff6b6b, #ff4444);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(255, 68, 68, 0.35);
}

.bar-btn-stop {
  background: linear-gradient(135deg, #666, #444);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.25);
}

.bar-btn-restart {
  background: #f0f0f0;
  color: #333;
}

.bar-btn-confirm {
  background: linear-gradient(135deg, #07c160, #06ad56);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(7, 193, 96, 0.35);
}

.bar-actions {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.bar-actions .bar-btn {
  flex: 1;
}

.bar-btn-icon {
  font-size: 36rpx;
  line-height: 1;
}

.bar-btn-text {
  font-size: 32rpx;
}

.bar-stats {
  font-size: 24rpx;
  color: #999;
}
