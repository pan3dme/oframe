/* places/picker/picker.wxss */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.picker-wrap {
  flex: 1;
  position: relative;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.picker-map {
  flex: 1;
  width: 100%;
}

/* 固定在中心的图钉 */
.pin-overlay {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  pointer-events: none;
  z-index: 10;
  margin-top: -16rpx; /* 偏移让针尖对准中心 */
}

.pin-icon {
  font-size: 48rpx;
  line-height: 1;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.pin-shadow {
  width: 10rpx;
  height: 10rpx;
  background: rgba(0, 0, 0, 0.25);
  border-radius: 50%;
  margin: 4rpx auto 0;
}

/* 底部信息栏 */
.picker-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx 28rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.06);
  gap: 20rpx;
}

.bar-coords {
  flex: 1;
  min-width: 0;
}

.bar-coord-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.bar-coord-val {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bar-confirm {
  flex-shrink: 0;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 36rpx;
  background: #07c160;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 36rpx;
  text-align: center;
}

.bar-confirm:active {
  opacity: 0.8;
}
