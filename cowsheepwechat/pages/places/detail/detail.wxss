/* places/detail/detail.wxss */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.place-map {
  flex: 1;
  width: 100%;
}

/* 右上角悬浮信息栏（半透明，可透出地图） */
.bottom-bar {
  position: fixed;
  top: 200rpx;
  right: 20rpx;
  z-index: 998;
  background: rgba(255, 255, 255, 0.8);
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  min-width: 260rpx;
}

.bar-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 6rpx;
}

.bar-info {
  font-size: 24rpx;
  color: #999;
}
