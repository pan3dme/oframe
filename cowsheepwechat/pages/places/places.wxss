/* places.wxss - 地名管理样式 */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.toolbar-count {
  font-size: 26rpx;
  color: #999;
}

.toolbar-btn {
  background: #1989fa;
  color: #fff;
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-weight: 600;
}

.toolbar-btn:active {
  opacity: 0.8;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.loading-tip,
.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #1989fa;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 16rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #bbb;
  margin-top: 8rpx;
}

.place-list {
  padding: 16rpx 20rpx;
}

.place-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.place-item:active {
  background: #f9f9f9;
}

.place-info {
  flex: 1;
  min-width: 0;
}

.place-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.place-id {
  font-size: 22rpx;
  color: #ff976a;
  margin-bottom: 6rpx;
}

.place-gps {
  font-size: 22rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.place-level {
  font-size: 22rpx;
  color: #07c160;
  margin-top: 2rpx;
}

.place-actions {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.place-action-btn {
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  border: 1rpx solid #ddd;
  color: #666;
  margin-bottom: 12rpx;
  text-align: center;
  display: block;
}

.place-action-map {
  color: #1989fa;
  border-color: #1989fa;
}

.place-action-map:active {
  background: #1989fa;
  color: #fff;
}

.place-action-delete {
  color: #e74c3c;
  border-color: #e74c3c;
}

.place-action-delete:active {
  background: #e74c3c;
  color: #fff;
}

/* ========== 弹窗 ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
}

.modal {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  z-index: 101;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  text-align: center;
  margin-bottom: 28rpx;
}

.modal-field {
  margin-bottom: 20rpx;
}

.modal-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.required {
  color: #e74c3c;
}

.modal-input {
  width: 100%;
  height: 72rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 10rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* GPS 坐标行：输入框 + 选坐标按钮 */
.gps-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.gps-input {
  flex: 1;
  background: #f5f5f5;
  color: #999;
}

.gps-pick-btn {
  flex-shrink: 0;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 20rpx;
  background: #07c160;
  color: #fff;
  font-size: 26rpx;
  border-radius: 10rpx;
  font-weight: 600;
}

.gps-pick-btn:active {
  opacity: 0.8;
}

.modal-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 30rpx;
  border-radius: 40rpx;
  font-weight: 600;
}

.modal-btn-cancel {
  background: #f5f5f5;
  color: #666;
}

.modal-btn-confirm {
  background: #1989fa;
  color: #fff;
}

.modal-btn:active {
  opacity: 0.8;
}
