/**settings.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
  padding-bottom: 40rpx;
}

/* 分组卡片 */
.section {
  margin: 24rpx 24rpx 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #999;
  margin-bottom: 20rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 设置行 */
.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
}
.setting-row + .setting-row {
  border-top: 1rpx solid #f5f5f5;
}

.setting-left {
  display: flex;
  align-items: center;
}

.setting-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.setting-label {
  font-size: 30rpx;
  color: #333;
}

/* 设置行右侧的只读值（如农场坐标） */
.setting-value {
  font-size: 26rpx;
  color: #666;
  text-align: right;
  max-width: 420rpx;
  word-break: break-all;
  line-height: 1.5;
}

/* 可点击的值（点击打开地图查看） */
.setting-value.link {
  color: #576B95; /* 微信链接蓝 */
  text-decoration: underline;
}

/* 右侧值 + 小按钮组合容器 */
.setting-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

/* 小按钮（如：下发中继） */
.mini-btn {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 0 20rpx;
  height: 52rpx;
  line-height: 52rpx;
  font-size: 22rpx;
  color: #fff;
  background: #07c160;
  border-radius: 26rpx;
  box-shadow: 0 2rpx 6rpx rgba(7, 193, 96, 0.3);
}

.mini-btn:active {
  opacity: 0.8;
}

/* 操作行（清理缓存等） */
.action-row {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
}

.action-row:active {
  background: #f5f5f5;
  margin: 0 -32rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
  border-radius: 12rpx;
}

.action-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.action-info {
  flex: 1;
  min-width: 0;
}

.action-label {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

/* 退出登录红色样式 */
.logout-label {
  color: #fa5151;
}

.action-desc {
  font-size: 24rpx;
  color: #bbb;
  line-height: 1.6;
  margin-top: 6rpx;
  display: block;
}
