/**relay-dtu-cmd.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.section-placeholder {
  height: 40rpx;
}

/* ===== 通用卡片 ===== */
.section-card {
  margin: 16rpx 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 8rpx;
  border-left: 6rpx solid #1989fa;
}

/* ===== 设备下拉 ===== */
.cmd-picker {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #333;
  box-sizing: border-box;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cmd-picker::after {
  content: '▼';
  font-size: 22rpx;
  color: #999;
}

/* 中继转发下拉特殊样式 */
.relay-picker {
  border-color: #ff9500;
  background: #fffaf5;
}

.relay-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999;
  padding-left: 4rpx;
}

/* ===== 指令输入 ===== */
.cmd-input {
  width: 100%;
  min-height: 160rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-bottom: 24rpx;
  font-family: 'Courier New', monospace;
  line-height: 1.6;
}

/* ===== 快捷按钮 ===== */
.quick-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.quick-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.quick-btn {
  flex: 0 0 calc((100% - 24rpx) / 3);
  height: 60rpx;
  line-height: 60rpx;
  font-size: 22rpx;
  padding: 0;
  border-radius: 10rpx;
  background: #f5f5f5;
  color: #666;
  border: 1rpx solid #e0e0e0;
  margin: 0;
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  box-sizing: border-box;
}

.quick-btn.quick-active {
  background: #e3f2fd;
  color: #1989fa;
  border-color: #1989fa;
  font-weight: 600;
}

/* ===== 发送按钮 ===== */
.send-section {
  margin: 24rpx 24rpx;
}

.send-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #07c160;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 14rpx;
  padding: 0;
  margin: 0;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}

.send-btn:active {
  background: #06ad56;
}

/* ===== 发送日志 ===== */
.log-card {
  margin: 0 24rpx 16rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  max-height: 600rpx;
}

.log-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
  border-left: 6rpx solid #ff9500;
}

.log-list {
  max-height: 520rpx;
  overflow-y: auto;
}

.log-item {
  display: flex;
  align-items: flex-start;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #fafafa;
}

.log-time {
  font-size: 20rpx;
  color: #aaa;
  font-family: 'Courier New', monospace;
  white-space: nowrap;
  margin-right: 8rpx;
  min-width: 100rpx;
}

.log-type {
  font-size: 20rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.log-type-info {
  background: #e3f2fd;
  color: #1976d2;
}

.log-type-success {
  background: #e8f5e9;
  color: #388e3c;
}

.log-type-error {
  background: #ffebee;
  color: #d32f2f;
}

.log-text {
  font-size: 22rpx;
  color: #555;
  word-break: break-all;
  line-height: 1.5;
}

/* ===== 工作时间弹框 ===== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-container {
  width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  padding: 36rpx 0 20rpx;
}

.modal-body {
  padding: 0 48rpx 36rpx;
}

.time-picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.time-picker-label {
  font-size: 28rpx;
  color: #333;
}

.time-picker-value {
  font-size: 32rpx;
  color: #1989fa;
  font-weight: 600;
  padding: 8rpx 24rpx;
  background: #f0f7ff;
  border-radius: 10rpx;
  border: 2rpx solid #b3d9ff;
}

.time-picker-divider {
  text-align: center;
  font-size: 28rpx;
  color: #999;
  padding: 8rpx 0;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.modal-btn {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 30rpx;
  border-radius: 0;
  padding: 0;
  margin: 0;
  background: #fff;
  border: none;
}

.modal-btn-cancel {
  color: #999;
  border-right: 1rpx solid #f0f0f0;
}

.modal-btn-confirm {
  color: #1989fa;
  font-weight: 600;
}

/* ===== 配置下发弹框 ===== */
/* 弹框内容区（可滚动） */
.config-scroll {
  max-height: 56vh;
  overflow-y: auto;
  padding: 0 40rpx;
}

/* 每组配置 */
.config-group {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.config-group:last-child {
  border-bottom: none;
}

.config-group-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.config-group-range {
  font-size: 22rpx;
  color: #ff9500;
  font-weight: normal;
  margin-left: 12rpx;
}

/* 周期输入框 */
.config-input {
  height: 76rpx;
  line-height: 76rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #333;
  background: #fafafa;
}

.config-hint {
  padding: 16rpx 40rpx 24rpx;
  font-size: 22rpx;
  color: #999;
  border-top: 1rpx solid #f0f0f0;
}

/* 开始/结束时间放一行两列 */
.time-picker-dual {
  display: flex;
  gap: 20rpx;
}

.time-picker-cell {
  flex: 1;
  background: #fafafa;
  border: 2rpx solid #f0f0f0;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
}

.time-picker-cell .time-picker-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.time-picker-cell .time-picker-value {
  display: block;
  text-align: center;
  font-size: 28rpx;
  padding: 10rpx 0;
}
