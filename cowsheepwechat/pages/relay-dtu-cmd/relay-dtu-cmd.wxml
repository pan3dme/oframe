<!--relay-dtu-cmd.wxml-->
<navigation-bar title="中继DTU指令" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">

  <!-- 设备选择 -->
  <view class="section-card">
    <view class="section-title">📡 目标设备</view>
    <picker mode="selector" range="{{deviceDisplayList}}" value="{{deviceIndex}}" bindchange="onDeviceChange">
      <view class="cmd-picker">{{deviceDisplayList[deviceIndex] || '请选择设备'}}</view>
    </picker>
  </view>

  <!-- 指令输入 -->
  <view class="section-card">
    <view class="section-title">⚡ 指令内容</view>
    <textarea class="cmd-input" value="{{cmdText}}" placeholder="输入指令JSON或文本..." bindinput="onCmdInput" auto-height maxlength="-1" />
    
    <!-- 快捷按钮 -->
    <view class="quick-label">快捷指令</view>
    <view class="quick-row">
      <button class="quick-btn {{quickSelected === 14 ? 'quick-active' : ''}}" bindtap="onQuickWorkTime">🕐 工作时间</button>
      <button class="quick-btn {{quickSelected === 16 ? 'quick-active' : ''}}" bindtap="onQuickTxPower">📡 发射功率</button>
      <button class="quick-btn {{quickSelected === 17 ? 'quick-active' : ''}}" bindtap="onQuickLoraSw">🔘 开关LORA({{loraSwValue}})</button>
      <button class="quick-btn {{quickSelected === 18 ? 'quick-active' : ''}}" bindtap="onQuickRelayReboot">🔄 重启中继</button>
      <button class="quick-btn {{quickSelected === 19 ? 'quick-active' : ''}}" bindtap="onQuickConfig">⚙️ 配置下发</button>
      <button class="quick-btn {{quickSelected === 4 ? 'quick-active' : ''}}" bindtap="onQuickDebug">🐛 开关Debug</button>
    </view>
  </view>

  <!-- 工作时间弹框 -->
  <view class="modal-overlay" wx:if="{{showWorkTimeModal}}" bindtap="onWorkTimeCancel">
    <view class="modal-container" catchtap="noop">
      <view class="modal-title">设置工作时间</view>
      <view class="modal-body">
        <view class="time-picker-row">
          <text class="time-picker-label">开始时间</text>
          <picker mode="time" value="{{workStartTime}}" bindchange="onWorkStartChange">
            <view class="time-picker-value">{{workStartTime}}</view>
          </picker>
        </view>
        <view class="time-picker-divider">~</view>
        <view class="time-picker-row">
          <text class="time-picker-label">结束时间</text>
          <picker mode="time" value="{{workEndTime}}" bindchange="onWorkEndChange">
            <view class="time-picker-value">{{workEndTime}}</view>
          </picker>
        </view>
      </view>
      <view class="modal-footer">
        <button class="modal-btn modal-btn-cancel" bindtap="onWorkTimeCancel">取消</button>
        <button class="modal-btn modal-btn-confirm" bindtap="onWorkTimeConfirm">确定</button>
      </view>
    </view>
  </view>

  <!-- 配置下发弹框 -->
  <view class="modal-overlay" wx:if="{{showConfigModal}}">
    <view class="modal-container config-modal">
      <view class="modal-title">⚙️ 配置下发</view>

      <view class="config-scroll">
        <!-- ① 上报周期（输入框 5-60） -->
        <view class="config-group">
          <view class="config-group-title">① 上报周期（秒）<text class="config-group-range">5-60</text></view>
          <input class="config-input" type="number" value="{{configPeriod}}" bindinput="onConfigPeriodInput" placeholder="请输入5-60" />
        </view>

        <!-- ② 开机时间（小时 0-24） -->
        <view class="config-group">
          <view class="config-group-title">② 开机时间（小时）</view>
          <view class="time-picker-dual">
            <view class="time-picker-cell">
              <text class="time-picker-label">开始时间</text>
              <picker mode="selector" range="{{startHourRange}}" value="{{configWorkStart}}" bindchange="onConfigWorkStartChange">
                <view class="time-picker-value">{{startHourRange[configWorkStart]}} 时</view>
              </picker>
            </view>
            <view class="time-picker-cell">
              <text class="time-picker-label">结束时间</text>
              <picker mode="selector" range="{{hourRange}}" value="{{configWorkEnd}}" bindchange="onConfigWorkEndChange">
                <view class="time-picker-value">{{hourRange[configWorkEnd]}} 时</view>
              </picker>
            </view>
          </view>
        </view>
      </view>

      <view class="config-hint">仅支持当天时间窗口（持续≥1小时），确定后将编码为两位代号填入指令内容</view>

      <view class="modal-footer">
        <button class="modal-btn modal-btn-cancel" bindtap="onConfigModalCancel">取消</button>
        <button class="modal-btn modal-btn-confirm" bindtap="onConfigModalConfirm">确定</button>
      </view>
    </view>
  </view>

  <!-- 发送按钮 -->
  <view class="send-section">
    <button class="send-btn" bindtap="onSend">发送指令</button>
  </view>

  <!-- 发送日志 -->
  <view class="log-card" wx:if="{{sendLog.length > 0}}">
    <view class="log-title">📋 发送日志</view>
    <view class="log-list">
      <view class="log-item" wx:for="{{sendLog}}" wx:key="index">
        <text class="log-time">[{{item.time}}]</text>
        <text class="log-type log-type-{{item.type}}">{{item.type === 'success' ? '✓' : item.type === 'error' ? '✗' : '→'}}</text>
        <text class="log-text">{{item.text}}</text>
      </view>
    </view>
  </view>

  <view class="section-placeholder"></view>
</scroll-view>
