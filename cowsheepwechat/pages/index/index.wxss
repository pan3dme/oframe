/**index.wxss**/
/* 复用设备详情页样式（头部卡片 / 数据记录列表等），保证首页详情与详情页视觉一致 */
@import "../device-detail/device-detail.wxss";

page {
  background: #f0f2f5;
}

.home-scroll {
  flex: 1;
  height: 0;
}

.home-bottom {
  height: 60rpx;
}

/* ========== 设备功能按钮（每行3个） ========== */
.home-features {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 24rpx 8rpx;
  margin-top: 15px;
}

.home-feature {
  width: 33.333%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 28rpx;
}

.home-feature-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.home-feature-emoji {
  font-size: 44rpx;
  line-height: 1;
  color: #fff;
}

.home-feature-label {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #333;
}

/* ========== 未选择设备：空状态 ========== */
.home-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 220rpx 80rpx 0;
}

.home-empty-icon {
  font-size: 120rpx;
  line-height: 1;
  margin-bottom: 40rpx;
  opacity: 0.8;
}

.home-empty-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 20rpx;
}

.home-empty-desc {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  line-height: 1.7;
  margin-bottom: 48rpx;
}

.home-empty-btn {
  width: 360rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  color: #fff;
  background: #1a73e8;
  border-radius: 44rpx;
  padding: 0;
  margin: 0;
  border: none;
}

.home-empty-btn::after {
  border: none;
}

