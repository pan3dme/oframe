/**index.wxss**/
/* 复用设备详情页样式（头部卡片 / 数据记录列表等），保证首页详情与详情页视觉一致 */
@import "../device-detail/device-detail.wxss";

page {
  /* 自定义 tabBar 为固定定位覆盖在页面之上，页面高度需减去 tabBar 高度，避免内容底部被遮挡 */
  height: calc(100vh - 100rpx);
  height: calc(100vh - 100rpx - constant(safe-area-inset-bottom));
  height: calc(100vh - 100rpx - env(safe-area-inset-bottom));
  background: #f0f2f5;
}

.home-scroll {
  flex: 1;
  height: 0;
}

.home-bottom {
  height: 60rpx;
}

/* ========== 设备功能按钮（每行3个） ========== */
.home-features {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 24rpx 8rpx;
  margin-top: 15px;
}

.home-feature {
  width: 33.333%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 28rpx;
}

.home-feature-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.home-feature-emoji {
  font-size: 44rpx;
  line-height: 1;
  color: #fff;
}

.home-feature-label {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #333;
}

/* 中继设备功能按钮（数据列表/设备设置/修改密码/电子栅栏）：与普通设备一致，每行3个 */
/* ========== 未选择设备：空状态 ========== */
.home-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 220rpx 80rpx 0;
}

.home-empty-icon {
  font-size: 120rpx;
  line-height: 1;
  margin-bottom: 40rpx;
  opacity: 0.8;
}

.home-empty-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 20rpx;
}

.home-empty-desc {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  line-height: 1.7;
  margin-bottom: 48rpx;
}

.home-empty-btn {
  width: 360rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  color: #fff;
  background: #1a73e8;
  border-radius: 44rpx;
  padding: 0;
  margin: 0;
  border: none;
}

.home-empty-btn::after {
  border: none;
}

/* ========== 图片压缩 canvas（隐藏，编辑设备图片压缩用） ========== */
.compress-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 512px;
  height: 512px;
  opacity: 0;
  pointer-events: none;
}


/* 设备名后的固件版本小字（来自type=8缓存） */
.header-version {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.65);
  font-weight: 400;
}

/* ========== 设备信息实时查询面板（点击⚙️后显示） ========== */
.vision-panel {
  margin: 20rpx 24rpx 0;
  padding: 24rpx 28rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}
.vision-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.vision-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a73e8;
}
.vision-close {
  font-size: 30rpx;
  color: #999;
  padding: 0 12rpx;
}
.vision-grid {
  display: flex;
  flex-wrap: wrap;
}
.vision-item {
  width: 50%;
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  box-sizing: border-box;
  padding-right: 16rpx;
}
.vision-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.vision-label {
  width: 150rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #999;
}
.vision-value {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  word-break: break-all;
}
.vision-raw {
  margin-top: 8rpx;
  padding: 14rpx 16rpx;
  background: #f7f9fc;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #666;
  word-break: break-all;
}
