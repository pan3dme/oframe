/**map.wxss**/
page {
  /* 自定义 tabBar 为固定定位覆盖在页面之上，页面高度需减去 tabBar 高度，避免地图被遮挡 */
  height: calc(100vh - 100rpx);
  height: calc(100vh - 100rpx - constant(safe-area-inset-bottom));
  height: calc(100vh - 100rpx - env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #222;
}

.map {
  flex: 1;
  width: 100%;
}

/* 左下角图层切换按钮（bottom 需避开自定义 tabBar） */
.layer-toggle {
  position: fixed;
  left: 20rpx;
  bottom: 120rpx;
  bottom: calc(120rpx + constant(safe-area-inset-bottom));
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.layer-toggle:active {
  background: rgba(230, 230, 230, 0.95);
}

.layer-toggle.layer-on {
  background: rgba(0, 200, 83, 0.15);
  border: 2rpx solid #00C853;
}

.layer-toggle.layer-on .layer-label {
  color: #00C853;
  font-weight: 600;
}

.layer-icon {
  font-size: 32rpx;
  line-height: 1;
}

.layer-label {
  font-size: 16rpx;
  color: #666;
  margin-top: 2rpx;
}

/* 右下角功能按钮组（bottom 需避开自定义 tabBar） */
.map-toolbar {
  position: fixed;
  right: 20rpx;
  bottom: 120rpx;
  bottom: calc(120rpx + constant(safe-area-inset-bottom));
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  z-index: 999;
}

.tool-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tool-btn:active {
  background: rgba(230, 230, 230, 0.95);
}

.tool-icon {
  font-size: 32rpx;
  color: #333;
  line-height: 1;
}

.tool-label {
  font-size: 16rpx;
  color: #666;
  margin-top: 2rpx;
}

/* 右上角：全体工作期间中继 GPS 指令按钮（样式与右下功能按钮一致） */
.gpstim-btn {
  position: fixed;
  right: 20rpx;
  top: 200rpx;
  z-index: 999;
}



