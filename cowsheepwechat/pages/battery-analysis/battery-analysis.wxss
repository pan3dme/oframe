/**battery-analysis.wxss**/
page {
  height: 100vh;
  width: 100vw;
  overflow-x: hidden;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}
.scrollarea {
  flex: 1;
  width: 100%;
  overflow-x: hidden;
  box-sizing: border-box;
  padding: 24rpx;
}

/* 设备选择卡片 */
.select-card {
  box-sizing: border-box;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}
.select-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}
.limit-label {
  margin-top: 20rpx;
}
.select-picker {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #f0f0f0;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #333;
  overflow: hidden;
}
.select-row {
  display: flex;
  align-items: center;
}
.select-row > picker {
  flex: 2;
}
.fetch-btn {
  margin-left: 20rpx;
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0;
  background: #1976d2;
  color: #fff;
  font-size: 26rpx;
  border-radius: 12rpx;
  border: none;
}
.fetch-btn::after {
  border: none;
}

/* 结果区 */
.result-card {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}
.result-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.empty-tip {
  text-align: center;
  padding: 40rpx 0;
  font-size: 28rpx;
  color: #999;
}

/* 表格 */
.record-table {
  width: 100%;
  overflow: hidden;
}
.table-header {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #e0e0e0;
}
.th {
  font-size: 24rpx;
  color: #999;
  font-weight: 600;
}
.td {
  font-size: 24rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.th-type, .td.th-type {
  width: 80rpx;
  text-align: center;
}
.th-battery, .td.th-battery {
  width: 120rpx;
  text-align: center;
}
.th-lorastr, .td.th-lorastr {
  flex: 1;
}
.th-time, .td.th-time {
  width: 160rpx;
  text-align: right;
}
.table-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.table-row:last-child {
  border-bottom: none;
}

/* 类型标签 */
.type-tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #fff;
  background: #999;
}
.type-tag.type-3 {
  background: #4CAF50;
}
.type-tag.type-1 {
  background: #1976d2;
}
.type-tag.type-2 {
  background: #ff9500;
}

/* 电量值高亮 */
.battery-val {
  font-weight: 600;
  color: #999;
}
.battery-highlight {
  color: #4CAF50;
  font-size: 28rpx;
}

/* 时间两行 */
.time-date {
  font-size: 22rpx;
  color: #666;
}
.time-clock {
  font-size: 22rpx;
  color: #999;
}

/* 电量趋势图表卡片 */
.chart-card {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}
.chart-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
  font-weight: 500;
}
.chart-canvas {
  width: 100%;
  height: 400rpx;
}
.chart-empty-card {
  display: flex;
  align-items: center;
  justify-content: center;
}
.chart-empty-text {
  text-align: center;
  padding: 60rpx 0;
  font-size: 28rpx;
  color: #999;
}
