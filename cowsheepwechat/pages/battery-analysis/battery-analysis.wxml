<!--battery-analysis/battery-analysis.wxml-->
<navigation-bar title="电量分析" back="{{true}}" color="black" background="#FFF"></navigation-bar>

<scroll-view class="scrollarea" scroll-y type="list">
  <!-- 设备选择区 -->
  <view class="select-card">
    <view class="select-label">选择设备</view>
    <picker mode="selector" range="{{deviceIdOptions}}" value="{{selectedDeviceIndex}}" bindchange="onDevicePickerChange">
      <view class="select-picker">
        <text>{{selectedDeviceId || '请选择设备'}}</text>
        <text class="picker-arrow">▼</text>
      </view>
    </picker>
    <button class="fetch-btn" bindtap="onFetchLogs" loading="{{loading}}">查询LOG记录</button>
  </view>

  <!-- 结果表格 -->
  <view class="result-card" wx:if="{{hasSearched}}">
    <view class="result-title">设备 {{selectedDeviceId}} 最近 {{records.length}} 条LOG</view>

    <view wx:if="{{records.length === 0}}" class="empty-tip">暂无LOG记录</view>

    <view class="record-table" wx:if="{{records.length > 0}}">
      <view class="table-header">
        <view class="th th-type">类型</view>
        <view class="th th-battery">电量值</view>
        <view class="th th-lorastr">lorastr</view>
        <view class="th th-time">时间</view>
      </view>
      <view class="table-body">
        <view class="table-row" wx:for="{{records}}" wx:key="rawTime">
          <view class="td th-type">
            <text class="type-tag type-{{item.msgType}}">{{item.msgType}}</text>
          </view>
          <view class="td th-battery">
            <text class="battery-val {{item.msgType === '3' ? 'battery-highlight' : ''}}">{{item.batteryVal}}</text>
          </view>
          <view class="td th-lorastr">{{item.lorastr}}</view>
          <view class="td th-time">
            <view class="time-date">{{item.date}}</view>
            <view class="time-clock">{{item.time_part}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>
</scroll-view>
