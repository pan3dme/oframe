<!--location-map.wxml-->
<navigation-bar title="定位详情" back="{{true}}" color="black" background="#FFF"></navigation-bar>

<!-- 绿色设备图钉图标（与地图中心设备一致），离屏绘制 -->
<canvas type="2d" id="devPinCanvas" style="width:28px;height:28px;position:fixed;left:-9999px"></canvas>

<!-- 蓝色"我的位置"圆点图标，离屏绘制（用于避免系统 show-location 蓝点与虚线起点的亚像素偏差） -->
<canvas type="2d" id="myPinCanvas" style="width:22px;height:22px;position:fixed;left:-9999px"></canvas>

<!-- 透明占位图标，离屏绘制（用于在虚线上显示距离文字） -->
<canvas type="2d" id="transparentCanvas" style="width:4px;height:4px;position:fixed;left:-9999px"></canvas>

<map id="locMap" class="map"
  latitude="{{nativeLat}}" longitude="{{nativeLng}}" scale="{{nativeScale}}"
  markers="{{markers}}" polyline="{{polylines}}" enable-satellite="{{isSatellite}}"
  bindregionchange="onRegionChange"
  bindmarkertap="onMarkerTap"
  bindcallouttap="onCalloutTap" />

<!-- 右上角悬浮信息栏 -->
<view class="info-bar" wx:if="{{originLat}}">
  <view class="info-row">
    <text class="info-label">坐标: </text>
    <text class="info-value coords">{{originLat}}, {{originLng}}</text>
  </view>
  <view class="info-row" wx:if="{{distanceText}}">
    <text class="info-label">距离: </text>
    <text class="info-value">{{distanceText}}</text>
  </view>
  <view class="info-row" wx:if="{{recordTime}}">
    <text class="info-label">时间: </text>
    <text class="info-value">{{recordTime}}</text>
  </view>
</view>

<!-- 左下角道路显示按钮（与地图中心图层切换一致） -->
<view class="layer-toggle {{showRoadLayer ? 'layer-on' : ''}}" bindtap="toggleLayer">
  <text class="layer-icon">🗺️</text>
  <text class="layer-label">{{layerLabel}}</text>
</view>

<!-- 右下角按钮 -->
<view class="map-toolbar">
  <view class="tool-btn" bindtap="moveToPoint">
    <text class="tool-icon">📍</text>
    <text class="tool-label">回点</text>
  </view>
</view>
