/**location-map.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #222;
}

/* 右上角悬浮信息栏（半透明，可透出地图） */
.info-bar {
  position: fixed;
  top: 200rpx;
  right: 20rpx;
  z-index: 998;
  background: rgba(255, 255, 255, 0.8);
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  font-size: 26rpx;
  color: #999;
  min-width: 80rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  word-break: break-all;
}

.info-value.coords {
  color: #333;
  font-weight: 600;
}

.map {
  flex: 1;
  width: 100%;
}

/* 左下角道路显示按钮 */
.layer-toggle {
  position: fixed;
  left: 20rpx;
  bottom: 60rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.layer-toggle:active {
  background: rgba(230, 230, 230, 0.95);
}

.layer-toggle.layer-on {
  background: rgba(0, 200, 83, 0.15);
  border: 2rpx solid #00C853;
}

.layer-toggle.layer-on .layer-label {
  color: #00C853;
  font-weight: 600;
}

.layer-icon {
  font-size: 32rpx;
  line-height: 1;
}

.layer-label {
  font-size: 16rpx;
  color: #666;
  margin-top: 2rpx;
}

/* 右下角功能按钮组 */
.map-toolbar {
  position: fixed;
  right: 20rpx;
  bottom: 60rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  z-index: 999;
}

.tool-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tool-btn:active {
  background: rgba(230, 230, 230, 0.95);
}

.tool-icon {
  font-size: 32rpx;
  color: #333;
  line-height: 1;
}

.tool-label {
  font-size: 16rpx;
  color: #666;
  margin-top: 2rpx;
}
