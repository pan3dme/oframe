<!--device.wxml-->
<navigation-bar title="设备管理" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<canvas type="2d" id="compressCanvas" style="width:512px;height:512px;position:fixed;left:-9999px"></canvas>
<scroll-view class="scrollarea" scroll-y type="list" refresher-enabled="{{true}}" refresher-triggered="{{refresherTriggered}}" bindrefresherrefresh="onPullDownRefresh">

<!-- 顶部操作栏 -->
<view class="toolbar">
  <view class="toolbar-count">共 {{deviceList.length}} 台设备</view>
  <view class="toolbar-btn" bindtap="onAdd" wx:if="{{isAdmin}}">＋ 新增设备</view>
</view>

  <!-- 设备列表（单行模式） -->
  <view class="list-panel" wx:if="{{deviceList.length > 0 && singleLineRecord}}">
    <view class="list-item list-item-compact" wx:for="{{deviceList}}" wx:key="deviceId" bindtap="onTapDevice" data-deviceid="{{item.deviceId}}">
      <text class="item-index">{{index + 1}}</text>
      <view class="item-icon-compact">📡</view>
      <view class="item-info">
        <view class="item-line-one">
          <text class="item-name-compact">{{item.deviceId}}{{item.rename ? ' (' + item.rename + ')' : ''}}</text>
          <text class="item-time-compact" wx:if="{{item.relativeTime}}" style="color:{{item.timeColor}};background:{{item.timeBgColor}}">{{item.relativeTime}}</text>
          <text class="item-time-compact" wx:else style="color:#999;background:#f5f5f5">{{item.date && item.date !== '-' ? item.date + ' ' + item.time_part : '暂无数据'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 设备列表（完整模式） -->
  <view class="list-panel" wx:elif="{{deviceList.length > 0}}">
    <view class="list-item" wx:for="{{deviceList}}" wx:key="deviceId" data-deviceid="{{item.deviceId}}" bindtap="onTapDevice">
      <text class="item-index">{{index + 1}}</text>
      <image class="item-device-pic" wx:if="{{item.picurl}}" src="{{item.picurl}}" mode="aspectFill" />
      <view class="item-avatar-placeholder" wx:else>📡</view>
      <view class="item-info">
        <view class="item-name">{{item.deviceId}}{{item.rename ? ' (' + item.rename + ')' : ''}}</view>
        <view class="item-meta" wx:if="{{!item.device_key}}">
          <text class="item-time" style="color:#ff9800;">请输入唯一编码</text>
        </view>
        <view class="item-id" wx:if="{{item.link_cowsheep_id}}">绑定牛羊: {{item.bindName || item.link_cowsheep_id}}</view>
        <view class="item-id" wx:else style="color:#ccc;">未绑定牛羊</view>
        <view class="item-meta">
          <text class="item-time">{{item.date && item.date !== '-' ? item.date + ' ' + item.time_part : ''}}</text>
          <text class="item-relative" wx:if="{{item.relativeTime}}" style="color:{{item.timeColor}}">（{{item.relativeTime}}）</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="list-panel" wx:else>
    <view class="empty-tip">暂无设备数据</view>
  </view>
</scroll-view>

<!-- 新增设备弹窗 -->
<view class="modal" wx:if="{{showAddModal}}">
  <view class="modal-mask" bindtap="onAddClose"></view>
  <view class="modal-dialog">
    <view class="modal-close" bindtap="onAddClose">✕</view>
    <view class="modal-title">新增设备</view>

    <view class="modal-label">设备ID</view>
    <input class="modal-input"
      value="{{addDeviceId}}"
      placeholder="请输入设备ID"
      bindinput="onAddDeviceIdInput" />

    <view class="modal-btns">
      <button class="modal-btn modal-btn-gray" bindtap="onAddClose">取消</button>
      <button class="modal-btn modal-btn-confirm" bindtap="onAddConfirm">确认新增</button>
    </view>
  </view>
</view>