<!--device.wxml-->
<navigation-bar title="设备列表" back="{{false}}" color="black" background="#FFF"></navigation-bar>
<canvas type="2d" id="compressCanvas" style="width:512px;height:512px;position:fixed;left:-9999px"></canvas>
<!-- 固定头部（不随列表滚动/下拉刷新移动）：分类筛选 + 新增按钮同一行 -->
<view class="page-header">
  <view class="category-bar">
    <view class="category-tab {{activeCategory === 'device' ? 'category-tab-active' : ''}}" bindtap="onSwitchCategory" data-cat="device">
      <text>设备</text><text class="category-tab-num">{{categoryCount.device}}</text>
    </view>
    <view class="category-tab {{activeCategory === 'relay' ? 'category-tab-active' : ''}}" bindtap="onSwitchCategory" data-cat="relay">
      <text>中继</text><text class="category-tab-num">{{categoryCount.relay}}</text>
    </view>
    <view class="category-tab {{activeCategory === 'offline' ? 'category-tab-active' : ''}}" bindtap="onSwitchCategory" data-cat="offline">
      <text>离线</text><text class="category-tab-num">{{categoryCount.offline}}</text>
    </view>
    <view class="toolbar-btn" bindtap="onAdd" wx:if="{{isAdmin}}">＋ 新增设备</view>
  </view>
</view>

<scroll-view class="scrollarea" scroll-y type="list" refresher-enabled="{{true}}" refresher-triggered="{{refresherTriggered}}" bindrefresherrefresh="onPullDownRefresh">

  <!-- 设备列表（单行显示） -->
  <view class="list-panel" wx:if="{{deviceList.length > 0}}">
    <view class="list-item list-item-compact" wx:for="{{deviceList}}" wx:key="deviceId" bindtap="onTapDevice" data-deviceid="{{item.deviceId}}">
      <text class="item-index">{{index + 1}}</text>
      <view class="item-status-signal" style="color:{{item.signalColor}}"><view class="sig-bar sig-1"></view><view class="sig-bar sig-2"></view><view class="sig-bar sig-3"></view><view class="sig-bar sig-4"></view></view>
      <view class="item-info">
        <view class="item-line-one">
          <text class="item-name-compact" style="color:{{item.nameColor}}">{{item.deviceId}}{{item.rename ? ' (' + item.rename + ')' : ''}}<text wx:if="{{item.battery}}" style="color:{{item.batteryColor}}">（{{item.battery}}）</text></text>
          <view wx:if="{{item.lastRecordType === 'gps'}}" class="item-type-dot item-type-dot-gps" style="background:{{item.dotColor}}"></view>
          <view wx:if="{{item.lastRecordType === 'time'}}" class="item-type-icon-clock" style="color:{{item.timeColor}}"></view>
          <text class="item-time-compact" wx:if="{{item.countdownText}}" style="color:{{item.timeColor}};background:{{item.timeBgColor}}">{{item.countdownText}}</text>
          <text class="item-time-compact" wx:else style="color:#999;background:#f5f5f5">暂无上报</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="list-panel" wx:else>
    <view class="empty-tip">{{activeCategory === 'relay' ? '暂无中继设备' : (activeCategory === 'offline' ? '暂无离线设备' : (activeCategory === 'device' ? (deviceOnlineOnly ? '暂无在线设备' : '暂无设备') : '暂无设备数据'))}}</view>
  </view>
</scroll-view>

<!-- 新增设备弹窗 -->
<view class="modal" wx:if="{{showAddModal}}">
  <view class="modal-mask" bindtap="onAddClose"></view>
  <view class="modal-dialog">
    <view class="modal-close" bindtap="onAddClose">✕</view>
    <view class="modal-title">新增设备</view>

    <view class="modal-label">设备ID</view>
    <input class="modal-input"
      value="{{addDeviceId}}"
      placeholder="请输入设备ID"
      bindinput="onAddDeviceIdInput" />

    <view class="modal-btns">
      <button class="modal-btn modal-btn-gray" bindtap="onAddClose">取消</button>
      <button class="modal-btn modal-btn-confirm" bindtap="onAddConfirm">确认新增</button>
    </view>
  </view>
</view>